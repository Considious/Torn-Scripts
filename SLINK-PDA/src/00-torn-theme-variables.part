  --tutorial-title-content-color: color-mix(in srgb, var(--slt-text) 33%, var(--slt-text)) !important;
  --tutorial-title-shadow: 0 0 2px color-mix(in srgb, var(--slt-bg) 50%, transparent) !important;
  --white-tooltip-arrow-bottom-left-filter: drop-shadow(0 1px 0 color-mix(in srgb, var(--slt-control) 95%, var(--slt-panel))) drop-shadow(0 2px 1px color-mix(in srgb, color-mix(in srgb, var(--slt-panel) 33%, var(--slt-bg)) 14%, transparent)) !important;
  --white-tooltip-arrow-filter: drop-shadow(0 1px 0 color-mix(in srgb, var(--slt-control) 95%, var(--slt-panel))) drop-shadow(0 2px 1px color-mix(in srgb, color-mix(in srgb, var(--slt-panel) 33%, var(--slt-bg)) 14%, transparent)) !important;
  --white-tooltip-arrow-middle-left-filter: drop-shadow(-1px 0 0 color-mix(in srgb, var(--slt-control) 95%, var(--slt-panel))) drop-shadow(-2px 0 1px color-mix(in srgb, color-mix(in srgb, var(--slt-panel) 33%, var(--slt-bg)) 14%, transparent)) !important;
  --white-tooltip-arrow-middle-right-filter: drop-shadow(1px 0 0 color-mix(in srgb, var(--slt-control) 95%, var(--slt-panel))) drop-shadow(2px 0 1px color-mix(in srgb, color-mix(in srgb, var(--slt-panel) 33%, var(--slt-bg)) 14%, transparent)) !important;
  --white-tooltip-arrow-top-left-filter: drop-shadow(0 -1px 0 color-mix(in srgb, var(--slt-control) 95%, var(--slt-panel))) drop-shadow(0 -2px 1px color-mix(in srgb, color-mix(in srgb, var(--slt-panel) 33%, var(--slt-bg)) 14%, transparent)) !important;
  --white-tooltip-box-shadow: color-mix(in srgb, var(--slt-bg) 65%, transparent) 0 0 2px !important;
  --zoom-tooltip-bg-color: color-mix(in srgb, var(--slt-control) 95%, var(--slt-panel)) !important;
  --zoom-tooltip-font-color: color-mix(in srgb, var(--slt-text) 33%, var(--slt-text)) !important;
}

/* Variables that Torn re-tints for jail / hospital / abroad. Those tints
   tell you your state, so by default they are left alone in those states.
   The popup can switch this to "theme" to override them too. */
html[data-slink-torn-theme][data-slink-torn-theme][data-thm-status="theme"] body,
html[data-slink-torn-theme][data-slink-torn-theme] body:not([data-layout="jail"]):not([data-layout="hospital"]):not([data-abroad="true"]) {
  --content-title-links: var(--slt-muted) !important;
  --content-title-links-hover: var(--slt-text) !important;
  --divider-white-left-linear-gradient: linear-gradient(to right, var(--slt-panel) 0%, transparent 100%) !important;
  --divider-white-right-linear-gradient: linear-gradient(to right, transparent 0%, var(--slt-panel) 100%) !important;
  --main-bg: color-mix(in srgb, var(--slt-panel) 49%, var(--slt-bg)) !important;
  --page-header-divider-border-bottom: 1px solid var(--slt-panel) !important;
  --tabs-active-bg-gradient: linear-gradient(180deg, var(--slt-panel) 0%, var(--slt-border) 100%) !important;
  --tabs-bg-gradient: linear-gradient(180deg, var(--slt-border) 0%, var(--slt-panel) 100%) !important;
  --tabs-hover-bg-gradient: linear-gradient(180deg, color-mix(in srgb, var(--slt-border) 49%, var(--slt-control)) 0%, color-mix(in srgb, var(--slt-control) 95%, var(--slt-panel)) 100%) !important;
  --title-color: var(--slt-text) !important;
  --title-text-shadow: 0 0 2px var(--slt-bg) !important;
  --top-links-icon-svg-fill: var(--slt-muted) !important;
  --top-links-icon-svg-hover-fill: var(--slt-text) !important;
  --tutorial-title-border-bottom-color: color-mix(in srgb, var(--slt-text) 10%, transparent) !important;
  --tutorial-title-border-top-color: var(--slt-bg) !important;
  --tutorial-title-gradient: linear-gradient(180deg, color-mix(in srgb, var(--slt-muted) 67%, var(--slt-border)) 0%, color-mix(in srgb, var(--slt-control) 95%, var(--slt-panel)) 100%) !important;
}

`;
