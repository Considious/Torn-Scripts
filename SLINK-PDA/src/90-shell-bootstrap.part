,
primeFactionMessage,
sendPrimedFactionMessage
,
openArmoryRecaller:() => {
dataState.settings.war.activeTab = 'armory';
writeDataState();
selectPage('combat', false);
selectSubpage('combat', 'war', false);
writeState();
renderWar(true);
openDashboard();
