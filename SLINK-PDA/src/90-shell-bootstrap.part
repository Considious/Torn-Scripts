function pdaPluginSettings(id, defaults = {}) {
if (!dataState.settings.plugins || typeof dataState.settings.plugins !== 'object') dataState.settings.plugins = {};
const current = dataState.settings.plugins[id];
dataState.settings.plugins[id] = { ...defaults, ...(current && typeof current === 'object' ? current : {}) };
return dataState.settings.plugins[id];
}
function pdaPluginCache(id, defaults = {}) {
if (!dataState.caches.plugins || typeof dataState.caches.plugins !== 'object') dataState.caches.plugins = {};
const current = dataState.caches.plugins[id];
dataState.caches.plugins[id] = { ...defaults, ...(current && typeof current === 'object' ? current : {}) };
return dataState.caches.plugins[id];
}
function registerPdaPlugin(plugin) {
if (!plugin || !/^[A-Za-z][A-Za-z0-9_-]{0,40}$/.test(String(plugin.id || ''))) throw new Error('Invalid PDA plugin id.');
const id = String(plugin.id);
if (pdaPlugins.has(id)) return pdaPlugins.get(id);
pdaPlugins.set(id, plugin);
const page = shadow.querySelector('[data-page-panel="quality-of-life"]');
const nav = page?.querySelector('.subnav');
if (nav && !nav.querySelector('[data-quality-of-life-tab="' + id + '"]')) {
const button = document.createElement('button');
button.type = 'button';
button.dataset.qualityOfLifeTab = id;
button.textContent = String(plugin.shortTitle || plugin.title || id);
nav.appendChild(button);
}
if (page && !page.querySelector('[data-quality-of-life-panel="' + id + '"]')) {
const panel = document.createElement('div');
panel.className = 'subpage';
panel.dataset.qualityOfLifePanel = id;
panel.hidden = true;
const root = document.createElement('div');
root.dataset.moduleRoot = id;
panel.appendChild(root);
page.appendChild(panel);
}
try { plugin.start?.(); } catch (error) { console.warn('[SLINK PDA] Plugin start:', id, error); }
try { plugin.render?.(); } catch (error) { console.warn('[SLINK PDA] Plugin render:', id, error); }
applyPermissionGates();
if (state.qualityOfLifeTab === id) selectSubpage('qualityOfLife', id, false);
renderAlerts();
return plugin;
}
global.SLINK_PDA_PLUGIN_API = Object.freeze({
register:registerPdaPlugin,
root:moduleRoot,
settings:pdaPluginSettings,
cache:pdaPluginCache,
save:writeDataState,
hasScope,
ensurePermission:ensurePermissionSession,
