let nextPermissionRecoveryAt = 0;
async function ensureAutomaticPermissionSession(force = false) {
if (permissionRecoveryBusy || !currentApiKey() || !termsAccepted('permission')) return validSession('permission');
if (!force && validSession('permission')) return validSession('permission');
if (!force && Date.now() < nextPermissionRecoveryAt) return null;
permissionRecoveryBusy = true;
try {
const session = await ensurePermissionSession(false);
nextPermissionRecoveryAt = 0;
renderAllModules();
if (hasScope('slink.adhd.alerts') && !moduleState.alerts.busy) global.setTimeout(() => void refreshAlerts(false), 0);
for (const plugin of pdaPlugins.values()) {
try { if (!plugin.scope || hasScope(plugin.scope)) void plugin.refresh?.(false); } catch {}
}
return session;
} catch (error) {
nextPermissionRecoveryAt = Date.now() + 5 * 60_000;
console.warn('[SLINK PDA] Automatic authentication:', errorMessage(error));
return null;
} finally {
permissionRecoveryBusy = false;
}
}
