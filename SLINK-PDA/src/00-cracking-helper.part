11 VCESSNA36G MILKSHAKE8 XC3DEFENSE 87DDARKMAN ACZERNEST5 6240682286 JPASSWORD2 F111111118 B5ZROMANCE GLA63SLVFV XDYNASTY9W KDEADHEAD4 KA3QI8FZWW LAWESOME38 ASASAS1369 COOLKID123 TREBLE1959 VWESTWOOD7 WILL2POWER C2QREI6ZSE DEMIDRON15 FYPROVIEW5 PPSMOOCH5T FGRANDAM82 28CHAZIE12 T5VKNIGHTS O3FLUFFY3U KAKASHKA12 LONGHORN12 DCRDK0XAZP VGEOFFREY2 MYYUQQR43A E719821982 FKTHERAPY6 FLUFFY1269 JBMICRON5S SXJQQQ1113 ANUSHKA123 IVBAMBAM9P BLITZBALL1 61UPHAT3H1';
  const CORE='ADMIN ANGEL BABY BEAR BLUE BOSS CHARLIE CHEESE COOKIE DARK DOG DRAGON FAMILY FIRE FLOWER FOOTBALL FREEDOM GINGER GREEN HAMMER HAPPY HARLEY HELLO HONEY HUNTER ILOVEYOU JORDAN KING LETMEIN LOVE LUCKY MASTER MICHAEL MONKEY MUSTANG PASSWORD PEANUT PRINCESS QWERTY RANGER ROCKYOU SECRET SHADOW SOCCER SUMMER SUNSHINE SUPERMAN TIGGER TRUST WELCOME WHATEVER WINTER';
  const affixes=[['XX',''],['','XX'],['XX','XX'],['X',''],['','X'],['','1'],['','12'],['','123'],['','01'],['','99'],['','00'],['_',''],['','_'],['.',''],['','.']];
  const normalize=value=>String(value??'').trim().toUpperCase().replaceAll('Ø','0');
  const valid=/^[A-Z0-9_.]{4,10}$/;
  function createMatcher(seed=SEED+' '+CORE){
    const words=new Set(),byLength=new Map(),cache=new Map(),common=new Set(CORE.split(' '));
    for(const raw of String(seed).split(/\s+/)){const word=normalize(raw);if(valid.test(word))words.add(word);}
    for(const word of words){let items=byLength.get(word.length);if(!items)byLength.set(word.length,items=[]);items.push(word);}
    for(const items of byLength.values())items.sort((a,b)=>Number(common.has(b))-Number(common.has(a))||a.localeCompare(b));
    const matches=(word,pattern)=>word.length===pattern.length&&[...pattern].every((slot,i)=>slot==='?'||slot===word[i]);
    return pattern=>{
      pattern=normalize(pattern);
      if(!/^[A-Z0-9_.?]{4,10}$/.test(pattern)||!pattern.includes('?')||pattern.replaceAll('?','').length<2)return {exact:[],variants:[]};
      if(cache.has(pattern))return cache.get(pattern);
      const exact=[];
      for(const word of byLength.get(pattern.length)||[]){if(matches(word,pattern))exact.push(word);if(exact.length===EXACT_LIMIT)break;}
      const variants=[],seen=new Set();
      for(const [before,after] of affixes){
        const length=pattern.length-before.length-after.length;
        if(length<MIN)continue;
        const first=pattern.slice(0,before.length),last=after?pattern.slice(-after.length):'';
        if(!matches(before,first)||!matches(after,last))continue;
        for(const core of byLength.get(length)||[]){
          if(!/^[A-Z]+$/.test(core))continue;
          const word=before+core+after;
          if(!words.has(word)&&!seen.has(word)&&matches(word,pattern)){seen.add(word);variants.push(word);}
          if(variants.length===VARIANT_LIMIT)break;
        }
        if(variants.length===VARIANT_LIMIT)break;
      }
      if(cache.size>=96)cache.delete(cache.keys().next().value);
      const value={exact,variants};cache.set(pattern,value);return value;
    };
  }
  const route=()=>global.location.pathname==='/page.php'&&new URLSearchParams(global.location.search).get('sid')?.toLowerCase()==='crimes'&&/^#\/?cracking(?:[/?]|$)/i.test(global.location.hash);
  function readPattern(row){
    const slots=row.querySelectorAll('[class*="charSlot___"]:not([class*="charSlotDummy"]),[class^="charSlot"]:not([class*="charSlotDummy"])');
    if(slots.length<MIN||slots.length>MAX)return '';
    return [...slots].map(slot=>{const char=normalize(slot.textContent);return /^[A-Z0-9_.]$/.test(char)?char:'?';}).join('');
  }
  function crackState(button){
    if(!button?.matches?.('button.commit-button'))return '';
    const label=button.getAttribute('aria-label')?.trim();
    if(label==='You have already cracked this password'&&button.getAttribute('aria-disabled')==='true')return 'confirmed';
    if(/^Crack,\s*\d+\s+nerve$/i.test(label||'')&&button.getAttribute('aria-disabled')==='false'&&!button.disabled)return 'ready';
    return '';
  }
  function connect({eligible,loadShard,contribution}){
    const doc=global.document;
    let enabled=false,disposed=false,root=null,watch=null,discoverWatch=null,frame=null,matcher=null,style=null;
    const panels=new Map();
    const pending=new Map(),confirmed=new Set();
    const queues=new Map();let uploading=false;
    const rowSelector='[class*="crimeOptionWrapper___"],[class^="crimeOptionWrapper"]';
    const shards=new Map();
    const active=()=>enabled&&!disposed&&!doc.hidden&&route()&&eligible();
    const canShare=()=>active()&&doc.hasFocus();
    async function bounded(operation){
      let timer;
      try{return await Promise.race([Promise.resolve().then(operation),new Promise((_,reject)=>{timer=global.setTimeout(()=>reject(Error('Cracking service timed out.')),10000);})]);}
      finally{global.clearTimeout(timer);}
    }
    function clear(){
      if(frame!==null)global.cancelAnimationFrame(frame);frame=null;
      watch?.disconnect();watch=null;discoverWatch?.disconnect();discoverWatch=null;root=null;
      for(const panel of panels.values())panel.remove();panels.clear();style?.remove();style=null;
      pending.clear();
    }
    function recordAttempt(event){
      if(!event.isTrusted||!canShare())return;
      const button=event.target.closest?.('button.commit-button'),row=button?.closest(rowSelector);
      if(!row||!root?.contains(row)||crackState(button)!=='ready')return;
      const answer=readPattern(row);if(!valid.test(answer))return;
      if(pending.size>=24)pending.delete(pending.keys().next().value);
      pending.set(row,{answer,owner:contribution?.owner?.(),at:Date.now()});
      void flushConfirmed();
    }
    function queueFor(owner){
      const key='slink.cracking.confirmed.v1.'+owner;
      if(!queues.has(key)){
        let saved;try{saved=JSON.parse(global.localStorage.getItem(key));}catch{}
        queues.set(key,{key,retryAt:Math.min(Date.now()+1800000,Number(saved?.retryAt)||0),failures:Math.max(0,Math.min(6,Number(saved?.failures)||0)),words:new Set(Array.isArray(saved?.words)?saved.words.filter(word=>typeof word==='string'&&valid.test(word)).slice(0,256):[])});
      }
      return queues.get(key);
    }
    function saveQueue(queue){try{global.localStorage.setItem(queue.key,JSON.stringify({retryAt:queue.retryAt,failures:queue.failures,words:[...queue.words]}));}catch{}}
    async function flushConfirmed(){
      const owner=contribution?.owner?.();if(!canShare()||!owner||uploading)return;
      const queue=queueFor(owner);if(!queue.words.size||Date.now()<queue.retryAt)return;
      uploading=true;
      try{
        for(let batch=0;batch<5&&queue.words.size&&canShare()&&contribution.owner()===owner;batch++){
          const answers=[...queue.words].slice(0,20);
          const result=await bounded(()=>contribution.send({schema:1,answers}));
          if(result?.ok!==true||!Array.isArray(result.accepted))throw Error('Cracking upload was not acknowledged.');
          const accepted=new Set(result.accepted.filter(answer=>answers.includes(answer)));
          for(const answer of answers){queue.words.delete(answer);if(!accepted.has(answer))queue.words.add(answer);}
          if(!accepted.size)throw Error('No Cracking answers were acknowledged.');
          queue.failures=0;queue.retryAt=0;saveQueue(queue);
          if(queue.words.size)await new Promise(resolve=>global.setTimeout(resolve,750));
        }
      }catch{
        queue.failures=Math.min(6,queue.failures+1);
        queue.retryAt=Date.now()+Math.min(1800000,60000*2**(queue.failures-1));saveQueue(queue);
      }finally{uploading=false;}
    }
    function checkConfirmed(){
      if(!canShare()){pending.clear();return;}
      for(const [row,{answer,owner:attemptOwner,at}] of pending){
        if(!root.contains(row)||Date.now()-at>15000||readPattern(row)!==answer){pending.delete(row);continue;}
        if(![...row.querySelectorAll('button.commit-button')].some(button=>crackState(button)==='confirmed'))continue;
        pending.delete(row);
        if(confirmed.has(answer))continue;
        if(confirmed.size>=128)confirmed.delete(confirmed.keys().next().value);
        confirmed.add(answer);
        const owner=contribution?.owner?.();
        if(owner&&owner===attemptOwner){const queue=queueFor(owner);if(queue.words.size<256)queue.words.add(answer);saveQueue(queue);void flushConfirmed();}
      }
    }
    const el=(tag,text)=>{const node=doc.createElement(tag);if(text!==undefined)node.textContent=text;return node;};
    function shard(pattern){
      const bucket=pattern[0]==='?'?'common':pattern[0]==='.'?'dot':pattern[0],key=pattern.length+'/'+bucket;
      if(!shards.has(key)){
        if(shards.size>=12){const old=[...shards].find(([,item])=>!item.pending);if(old)shards.delete(old[0]);else return null;}
        shards.set(key,{key,length:pattern.length,bucket,words:new Set(),next:0,revision:0,pending:false,error:false});
      }
      return shards.get(key);
    }
    async function fetchShard(entry){
      if(!loadShard||!active()||!entry||entry.pending||entry.next===null)return;
      entry.pending=true;entry.error=false;const page=entry.next;entry.revision++;schedule();
      try{
        const data=await bounded(()=>loadShard({length:entry.length,bucket:entry.bucket,page}));
        if(data?.schema!==1||!Array.isArray(data.words)||data.words.length>4096||!(data.next===null||data.next===page+1&&data.next<16))throw Error('Invalid dictionary page.');
        for(const word of data.words)if(typeof word==='string'&&word.length===entry.length&&valid.test(word))entry.words.add(word);
        if(Array.isArray(data.learned)&&data.learned.length<=512)for(const word of data.learned)if(typeof word==='string'&&word.length===entry.length&&valid.test(word))entry.words.add(word);
        entry.next=data.next;
      }catch{entry.error=true;}
      finally{entry.pending=false;entry.revision++;schedule();}
    }
    function scan(){
      frame=null;if(!active()||!root?.isConnected)return;
      checkConfirmed();
      const seen=new Set();
      for(const row of root.querySelectorAll('[class*="crimeOptionWrapper___"],[class^="crimeOptionWrapper"]')){
        const pattern=readPattern(row),known=pattern.replaceAll('?','').length;
        if(!pattern||!pattern.includes('?')||known<2)continue;
        seen.add(row);
        const entry=loadShard?shard(pattern):null;
        if(entry?.revision===0)void fetchShard(entry);
        const version=pattern+'/'+(entry?.revision??0),prior=panels.get(row);
        if(prior?.isConnected&&prior.dataset.pattern===version)continue;
        const local=(matcher||=createMatcher())(pattern),exact=[...local.exact],matched=new Set(exact);
        if(entry&&exact.length<EXACT_LIMIT)for(const word of entry.words){
          if(matched.has(word)||![...pattern].every((slot,i)=>slot==='?'||slot===word[i]))continue;
          exact.push(word);matched.add(word);if(exact.length===EXACT_LIMIT)break;
        }
        const variants=local.variants.filter(word=>!entry?.words.has(word));
        const panel=prior||el('div');panel.dataset.slinkCrackingAdvice='';panel.dataset.pattern=version;
        const results=[];
        if(exact.length)results.push(el('div','Dictionary matches: '+exact.join(' · ')));
        if(variants.length)results.push(el('div','Variant guesses: '+variants.join(' · ')));
        if(!results.length)results.push(el('div',entry?.words.size?'No match in the loaded dictionary.':'No match in the starter dictionary.'));
        if(entry?.pending)results.push(el('div','Loading more dictionary entries…'));
        else if(entry&&entry.next!==null){
          if(entry.error)results.push(el('div','Shared dictionary unavailable; offline matches still work.'));
          const more=el('button',entry.error?'Retry dictionary':'Load more dictionary');more.type='button';
          more.addEventListener('click',event=>{event.stopPropagation();void fetchShard(entry);});results.push(more);
        }
        panel.replaceChildren(...results);
        if(!panel.isConnected)row.append(panel);
        panels.set(row,panel);
      }
      for(const [row,panel] of panels)if(!seen.has(row)){panel.remove();panels.delete(row);}
    }
    function schedule(){if(frame===null&&active())frame=global.requestAnimationFrame(scan);}
    const crimeSelector='[class*="currentCrime___"],[class^="currentCrime"]';
    function discover(){
      const next=doc.querySelector(crimeSelector);
      if(next===root)return;
      watch?.disconnect();pending.clear();for(const panel of panels.values())panel.remove();panels.clear();root=next;
      if(!root)return;
      watch=new global.MutationObserver(records=>{
        if(records.some(record=>!(record.target.nodeType===1?record.target:record.target.parentElement)?.closest('[data-slink-cracking-advice]')&&
          !(record.type==='childList'&&[...record.addedNodes,...record.removedNodes].every(node=>node.matches?.('[data-slink-cracking-advice]')))))schedule();
      });
      watch.observe(root,{subtree:true,childList:true,characterData:true,attributes:true,attributeFilter:['class','aria-label','aria-disabled','disabled']});schedule();
    }
