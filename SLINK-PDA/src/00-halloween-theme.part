(function installHalloweenTheme(global){
 'use strict';
 // Original SLINK theme; same approved CSS/art package in Theme Lab, extension and PDA.
 const definition={"id":"halloween-2026","label":"Halloween 2026","description":"Exclusive 2026 haunted landscape with purple, green, and restrained pumpkin-orange lighting.","scope":"slink.theme.halloween","ornament":"halloween","swatch":["#08050f","#a72cff","#75ff42"],"assets":{"background":"https://raw.githubusercontent.com/Considious/SLINK-Cloudflare-Services/main/themes/assets/halloween-2026-haunted-background-v1.webp","iconSheet":"https://raw.githubusercontent.com/Considious/SLINK-Cloudflare-Services/main/themes/assets/halloween-2026-icons.png","packaged":true,"brandIcon":"https://raw.githubusercontent.com/Considious/SLINK-Cloudflare-Services/main/themes/assets/halloween-2026-brand.png","chatIcon":"https://raw.githubusercontent.com/Considious/SLINK-Cloudflare-Services/main/themes/assets/halloween-2026-chat.png","frame":"https://raw.githubusercontent.com/Considious/SLINK-Cloudflare-Services/main/themes/assets/halloween-2026-silver-frame-v1.webp"},"tokens":{"--slink-bg":"#08050f","--slink-bg-raised":"#100b19","--slink-bg-control":"#181021","--slink-surface":"#0d0914","--slink-card":"#0b0811","--slink-control":"#1b1224","--slink-border":"rgba(205, 145, 255, .72)","--slink-border-soft":"rgba(185, 255, 159, .20)","--slink-text":"#f7f2ff","--slink-muted":"#c6b9d4","--slink-accent":"#a72cff","--slink-accent-alt":"#75ff42","--slink-ready":"#8dff65","--slink-warning":"#ff9a2f","--slink-error":"#ff6666","--slink-danger-bg":"#45151c","--slink-link":"#d7a6ff","--slink-shadow":"rgba(0, 0, 0, .88)","--slink-page-bg":"radial-gradient(circle at 14% 8%, rgba(159, 38, 255, .28), transparent 36%), radial-gradient(circle at 88% 88%, rgba(90, 255, 45, .18), transparent 38%), #07040c","--slink-topbar-bg":"linear-gradient(90deg, rgba(18, 9, 27, .95), rgba(5, 4, 9, .96) 52%, rgba(12, 22, 8, .94))","--slink-panel-bg":"linear-gradient(145deg, rgba(15, 10, 22, .91), rgba(5, 5, 8, .94))","--slink-button-bg":"linear-gradient(135deg, #6c159d, #21132f 55%, #357c1d)","--slink-selected-bg":"linear-gradient(135deg, #b727ff, #39144d 54%, #4fc326)","--slink-mark-bg":"linear-gradient(145deg, #cf89ff, #6a2491 42%, #151017 58%, #79f351)","--slink-glow-left":"rgba(120, 255, 62, .38)","--slink-glow-right":"rgba(178, 55, 255, .52)","--slink-metal":"#ecd8ff","--slink-metal-dark":"#654474"}},files=["medical-v2.webp","drug-v2.webp","booster-v2.webp","casino-v2.webp","addiction-v2.webp","shopping-v2.webp","flight-v2.webp","racing-v2.webp","education-v2.webp","stocks-v2.webp","oc-v2.webp","market-v2.webp","silver-frame-v1.webp","haunted-background-v1.webp"],sharedCss="/* Halloween 2026 refinement draft. Native markup; website-only until approved. */\n.theme-halloween-lab.theme-halloween-lab{--haunt-violet:#b95bff;--haunt-green:#94ff65;--haunt-orange:#ffac44;--haunt-ink:#0c0714;--haunt-landscape:url('./assets/haunted-background-v1.webp');--haunt-silver:url('./assets/silver-frame-v1.webp')}\n/* Fit the original scene to WIDTH, not the height of seventeen sample cards.\n   Repeating it keeps the landscape present all the way down the expanded lab. */\n.theme-halloween-lab.theme-halloween-lab:is(.window.main,.overlay,body){background-color:#10091b!important;background-image:linear-gradient(#0c071424,#0c07143d),var(--haunt-landscape)!important;background-size:100% 100%,100% auto!important;background-position:center top!important;background-repeat:no-repeat,repeat-y!important;background-attachment:scroll!important}\n.theme-halloween-lab.theme-halloween-lab :is(.module-view,.scroll,.content,.page,.subpage){background:transparent!important}\n.theme-halloween-lab.theme-halloween-lab .card:has(.alert-list,#adhd-alert-list){background:#10091b28!important;backdrop-filter:none!important}\n.theme-halloween-lab.theme-halloween-lab :is(.head,.topbar,.module-head,.status,.page-head){background:linear-gradient(105deg,#36134d35,#100b1938 60%,#31532024)!important;border-color:#ba65ff55!important;color:#f2e5ff}\n.theme-halloween-lab.theme-halloween-lab :is(.head,.topbar){border-bottom:1px solid #bf6dff88;box-shadow:0 1px 14px #8e26ce30}\n.theme-halloween-lab.theme-halloween-lab :is(.groups,.tabs,.subnav,.primary-nav,.dashboard-tabs,.efficiency-tabs,.quality-tabs){background:#120b1e40!important;gap:10px!important;padding-block:12px!important;padding-inline:12px!important;overflow:visible!important}\n.theme-halloween-lab.theme-halloween-lab :is(.tabs,.subnav,.efficiency-tabs,.quality-tabs){display:flex!important;flex-wrap:wrap}\n.theme-halloween-lab.theme-halloween-lab :is(.tab,.subnav button,.efficiency-tabs button,.quality-tabs button){flex:1 1 86px;min-width:0;min-height:34px;white-space:normal;line-height:1.25}\n.theme-halloween-lab.theme-halloween-lab :is(.group-tab,.tab,.subnav button,.primary-nav button,.dashboard-tabs button){position:relative;background:linear-gradient(130deg,#341546a6,#100a1ae0 65%,#263d2040)!important;border:1px solid #9c52ca80!important;border-radius:9px;color:#e5d4f2;box-shadow:inset 0 1px #ead4ff20,0 2px 6px #0006}\n.theme-halloween-lab.theme-halloween-lab :is(.group-tab,.tab,.subnav button,.primary-nav button,.dashboard-tabs button)[aria-selected=true]{background:linear-gradient(120deg,#7025aa90,#281333d0 65%,#4161246b)!important;border-color:#c57aff!important;color:#fff5e5;box-shadow:-2px 0 10px #a82cff55,2px 0 10px #8bf34330,inset 0 1px #e2b9ff40}\n.theme-halloween-lab.theme-halloween-lab :is(.groups,.tabs,.subnav,.primary-nav,.dashboard-tabs,.efficiency-tabs,.quality-tabs)>button{position:relative;overflow:visible!important;padding-right:18px!important}\n.theme-halloween-lab.theme-halloween-lab :is(.groups,.tabs,.subnav,.primary-nav,.dashboard-tabs,.efficiency-tabs,.quality-tabs) :is(.nav-alert-count,.nav-count){position:absolute!important;inset:0 0 auto auto!important;transform:translate(50%,-50%)!important;z-index:4;display:grid;place-items:center;box-sizing:border-box;margin:0!important;padding:0 4px!important;min-width:18px;height:18px;background:#881747;color:#fff;border:1px solid #ff9aa6;border-radius:99px;font:bold 10px/16px Arial,sans-serif;box-shadow:0 0 7px #e03c8266}\n.theme-halloween-lab.theme-halloween-lab :is(.nav-alert-count,.nav-count)[hidden]{display:none!important}\n.theme-halloween-lab.theme-halloween-lab :is(.slink-adhd-alert,.alert-list>.alert,.adhd-alert-card){--haunt-edge:#ad50ef;--haunt-opposite:#91e853;position:relative;box-sizing:border-box;display:grid!important;grid-template-columns:minmax(0,1fr) 62px;gap:5px 10px;min-height:0!important;padding:14px!important;border:1px solid color-mix(in srgb,var(--haunt-edge) 60%,#17101f)!important;border-radius:12px!important;background:linear-gradient(120deg,color-mix(in srgb,var(--haunt-edge) 16%,transparent),#100a189e 48%,color-mix(in srgb,var(--haunt-opposite) 11%,transparent)),#100a18a3!important;box-shadow:-2px 0 12px color-mix(in srgb,var(--haunt-edge) 18%,transparent),2px 0 12px color-mix(in srgb,var(--haunt-opposite) 12%,transparent),inset 0 1px #efd6ff1a!important;overflow:visible!important;color:#f5ecff;font:12px/1.45 Arial,sans-serif}\n.theme-halloween-lab.theme-halloween-lab :is(.slink-adhd-alert,.alert-list>.alert,.adhd-alert-card):nth-child(3n+2){--haunt-edge:#8df34d;--haunt-opposite:#a64eff}\n.theme-halloween-lab.theme-halloween-lab :is(.slink-adhd-alert,.alert-list>.alert,.adhd-alert-card):nth-child(3n){--haunt-edge:#f79630;--haunt-opposite:#af4cff}\n.theme-halloween-lab.theme-halloween-lab :is(.slink-adhd-alert,.alert-list>.alert,.adhd-alert-card)::after{content:\"\";position:absolute;inset:0;z-index:2;box-sizing:border-box;border:16px solid transparent;border-image:var(--haunt-silver) 38% 20% / 25px 36px / 0 stretch;pointer-events:none}\n.theme-halloween-lab.theme-halloween-lab :is(.slink-adhd-alert,.alert-list>.alert,.adhd-alert-card)>:is(strong,span:not(.halloween-alert-prop),div:not(.halloween-alert-prop)){grid-column:1;min-width:0}\n.theme-halloween-lab.theme-halloween-lab :is(.slink-adhd-alert,.alert-list>.alert,.adhd-alert-card) strong{font-size:14px;color:#fcf2ff;line-height:1.35}\n.theme-halloween-lab.theme-halloween-lab :is(.slink-adhd-alert,.alert-list>.alert,.adhd-alert-card) :is(p,span:not(.halloween-alert-prop)){color:#d8c6e6}\n.theme-halloween-lab.theme-halloween-lab .halloween-alert-prop{grid-column:2!important;grid-row:1/3;align-self:start;position:relative;display:block;width:62px;height:62px;margin:0!important;pointer-events:none;filter:drop-shadow(0 2px 4px #0007)}\n.theme-halloween-lab.theme-halloween-lab .halloween-alert-prop img{display:block;width:100%;height:100%;object-fit:contain}\n.theme-halloween-lab.theme-halloween-lab .halloween-prop-emblem{position:absolute;right:0;bottom:0;display:grid!important;place-items:center;width:19px;height:19px;margin:0!important;border:1px solid #c78eec;border-radius:50%;background:#140a20;color:#b6ff7d!important;font:bold 13px/1 Arial,sans-serif;box-shadow:0 1px 5px #0009}\n.theme-halloween-lab.theme-halloween-lab [data-halloween-kind=nerve] .halloween-prop-emblem{color:#ff867f!important}\n.theme-halloween-lab.theme-halloween-lab :is(.slink-adhd-links,.target-actions,.adhd-alert-actions){grid-column:1/-1!important;display:flex!important;flex-wrap:wrap;align-items:center;align-content:start;gap:7px!important;width:100%;min-height:0!important;margin-top:4px!important;padding:0!important}\n.theme-halloween-lab.theme-halloween-lab :is(.slink-adhd-links,.target-actions,.adhd-alert-actions)>:is(a,button){box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;flex:0 1 auto;min-width:0;min-height:30px;height:auto;padding:4px 8px;border:1px solid #9b58bd88!important;border-radius:7px;background:linear-gradient(#33203fce,#130e1deb)!important;color:#f0e3fa!important;text-decoration:none;font:12px/18px Arial,sans-serif;box-shadow:inset 0 1px #e4bfff18,0 2px 3px #0004}\n.theme-halloween-lab.theme-halloween-lab :is(.compact-stats,.slink-adhd-summary,.stats)>div{background:linear-gradient(125deg,#4b1c6040,#100a1b80 60%,#476a2938)!important;border:1px solid #9e57bb6b!important;border-radius:10px;box-shadow:inset 0 1px #f1d5ff17}\n/* Decorative overlays do not consume space or replace native icon pseudo-elements. */\n.theme-halloween-lab.theme-halloween-lab :is(.compact-stats,.slink-adhd-summary,.stats)>div{position:relative}\n.theme-halloween-lab.theme-halloween-lab :is(.group-tab,.tab,.subnav button,.primary-nav button,.dashboard-tabs button,.efficiency-tabs button,.quality-tabs button,.actions button,.slink-adhd-links>a,.slink-adhd-links>button,.target-actions>a,.target-actions>button,.adhd-alert-actions>button,.compact-stats>div,.slink-adhd-summary>div,.stats>div)::after{content:\"\";position:absolute;inset:0;z-index:2;box-sizing:border-box;border:8px solid transparent;border-image:var(--haunt-silver) 38% 20% / 13px 19px / 0 stretch;pointer-events:none}\n.theme-halloween-lab.theme-halloween-lab :is(.actions button,.slink-adhd-links>a,.slink-adhd-links>button,.target-actions>a,.target-actions>button,.adhd-alert-actions>button){position:relative}\n.theme-halloween-lab.theme-halloween-lab :is(.compact-stats,.slink-adhd-summary,.stats)>div::after{border-image-width:19px 25px}\n.theme-halloween-lab.theme-halloween-lab :is(.group-tab,.tab,.subnav button,.primary-nav button,.dashboard-tabs button,.efficiency-tabs button,.quality-tabs button){border-color:#c5bfd477!important}\n.theme-halloween-lab.theme-halloween-lab :is(.group-tab,.tab,.subnav button,.primary-nav button,.dashboard-tabs button,.efficiency-tabs button,.quality-tabs button):is([aria-selected=true],.active){box-shadow:-2px 0 12px #a82cff77,2px 0 12px #8bf34355,inset 0 1px #f5e5ff77!important}\n.theme-halloween-lab.theme-halloween-lab :is(button,a):focus-visible{outline:2px solid #baff80;outline-offset:3px}\n/* Header samples use native Torn classes; no border, padding or sizing overrides. */\n.halloween-header-samples{margin:0 0 22px;padding:20px;border:1px solid #6e4a8d;border-radius:14px;background:#10091d url('./assets/haunted-background-v1.webp') center 20%/cover;color:#f7eeff}\n.halloween-header-samples h2{font-size:16px;margin:0 0 14px}.halloween-header-samples .sample-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}\n.halloween-header-samples .sample-label{font-size:11px;color:#e1c4f1;margin:0 0 5px}\n.halloween-header-samples :is(.content-title,.crimes-app-header,.sidebar-header){position:relative;display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:38px;padding:8px 10px;background:linear-gradient(110deg,#8b34be30,#100a192b 55%,#78bb3430);border:0;border-radius:6px;box-shadow:inset 0 1px #d79cff66,inset 0 -1px #8bd85044;text-shadow:0 1px 3px #000;color:#fff1ff}\n.halloween-header-samples h4{font-size:12px;margin:0}.halloween-header-samples a{font-size:11px;color:#c7ffa1;text-decoration:none}.halloween-header-samples .sidebar-header{border-left:2px solid #9a50c7}.halloween-header-samples a:hover{text-decoration:underline}\n@media(max-width:760px){.halloween-header-samples .sample-grid{grid-template-columns:1fr}.halloween-header-samples{padding:14px}}\n";
 const remote='https://raw.githubusercontent.com/Considious/SLINK-Cloudflare-Services/main/themes/assets/';
 const states=new WeakMap(),cards='.slink-adhd-alert,.alert-list>.alert,.adhd-alert-card';
 const kinds={medicalCooldown:'medical',drugCooldown:'drug',boosterCooldown:'booster',energyRefill:'energy',nerveRefill:'nerve',casinoTokens:'casino',playerAddiction:'addiction',cityItem:'shopping',cityItems:'shopping',landing:'flight',travel:'flight',racing:'racing',education:'education',stockBenefits:'stocks',organizedCrime:'oc',mission:'mission'};
 const reuse={energy:'drug',nerve:'booster',mission:'education',service:'stocks',rare:'market'};
 function alertKind(id){id=String(id||'');return kinds[id]||(/market|^watch/i.test(id)?'market':/clusterRing|Unique/.test(id)?'rare':/^abroad|^travel|^flight/i.test(id)?'flight':/^rac/i.test(id)?'racing':/^oc[:_-]|^organized/i.test(id)?'oc':'service');}
 function markAlert(card,id){card.dataset.halloweenKind=alertKind(id);}
 function rootOf(host){return host.shadowRoot||host.ownerDocument;}
 function asset(file,options={}){
  if(options.assetBase)return new URL(file,options.assetBase).href;
  const name='halloween-2026-'+file;
  return global.chrome?.runtime?.getURL?global.chrome.runtime.getURL('assets/themes/'+name):remote+name;
 }
 function refresh(host,subtree){
  const state=states.get(host);if(!state?.active)return;
  const root=rootOf(host),surface=host.shadowRoot?root.querySelector('.window.main,.overlay'):root.body;if(!surface)return;
  surface.classList.add('theme-halloween-lab');
  const scope=subtree||root,targets=[...(scope.matches?.(cards)?[scope]:[]),...scope.querySelectorAll(cards)];
  for(const card of targets){
   const kind=card.dataset.halloweenKind||'service',previous=card.querySelector(':scope>.halloween-alert-prop');
   if(previous?.dataset.halloweenKind===kind)continue;
   previous?.remove();
   const prop=card.ownerDocument.createElement('span');prop.className='halloween-alert-prop';prop.setAttribute('aria-hidden','true');prop.dataset.halloweenKind=kind;
   const image=card.ownerDocument.createElement('img');image.src=asset((reuse[kind]||kind)+'-v2.webp',state.options);image.alt='';image.width=320;image.height=320;image.decoding='async';prop.append(image);
   if(['energy','nerve','rare'].includes(kind)){const emblem=card.ownerDocument.createElement('span');emblem.className='halloween-prop-emblem';emblem.textContent={energy:'ϟ',nerve:'♥',rare:'◆'}[kind];prop.append(emblem);}
   card.append(prop);
  }
 }
 function apply(host,id,options={}){
  let state=states.get(host);const root=rootOf(host);
  if(id!==definition.id){
   if(state){state.active=false;root.querySelectorAll('.theme-halloween-lab').forEach(e=>e.classList.remove('theme-halloween-lab'));root.querySelectorAll('.halloween-alert-prop').forEach(e=>e.remove());}
   return;
  }
  if(!state){const style=host.ownerDocument.createElement('style');style.dataset.halloweenThemeStyle='';(host.shadowRoot||root.head).append(style);state={style,active:false,options:null};states.set(host,state);}
  if(state.options?.assetBase!==options.assetBase||!state.active){state.style.textContent=sharedCss.replace(/url\((['"]?)(\.\/assets\/[^'")]+)\1\)/g,(_match,_quote,path)=>'url("'+asset(path.split('/').pop(),options)+'")');}
  state.active=true;state.options=options;refresh(host);
 }
 global.SLINK_HALLOWEEN_THEME=Object.freeze({definition,files,css:sharedCss,alertKind,markAlert,apply,refresh});
})(globalThis);
