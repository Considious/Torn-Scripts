 ${scope('.group-tab:nth-child(even)')},${scope('.tab:nth-child(even)')},${scope('.primary-nav button:nth-child(even)')},${scope('.secondary-nav button:nth-child(even)')},${scope('.dashboard-tabs button:nth-child(even)')},${scope('.efficiency-tabs button:nth-child(even)')}{box-shadow:inset 0 0 12px #c89a2444,0 0 7px #15eb6077}
 ${scope('[aria-selected=true]')},${scope('.dashboard-tab.active')},${scope('.efficiency-tab.active')}{background:linear-gradient(125deg,#a60820,#36060b 50%,#064022)!important;box-shadow:inset 0 0 17px #ff1c3a,0 0 9px #ff1c3a;color:#fff!important}
