 }
 function css(s){const scope=x=>s+' '+x;return `
 ${s}{color:#fff4dd}
 ${scope('.window.main')},${scope('.overlay')}{isolation:isolate;background:#050806 var(--naughty-background) center top/100% auto repeat-y!important;border-color:#ba8d36}
