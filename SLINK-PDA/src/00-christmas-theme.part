 ${scope('.compact-stats>div')},${scope('.stats>div')}{background:linear-gradient(135deg,#062b19dd,#060a08e8 45%,#4b0c1bdd)!important;box-shadow:inset -3px -3px 14px #ff173d66,inset 3px 3px 12px #17ef5e55}
 ${scope('.slink-adhd-alert')},${scope('.adhd-alert-card')},${scope('.alert')}{background:#060b08ed!important;border:12px solid transparent!important;border-image:var(--naughty-frame) 16% / 12px / 0 round!important;padding:10px!important;box-shadow:inset 3px 0 #ff2945,inset 0 0 17px #ff143b55,0 0 8px #ff173a88}
 ${scope('.slink-adhd-alert:nth-child(odd)')},${scope('.adhd-alert-card:nth-child(odd)')},${scope('.alert:nth-child(odd)')}{box-shadow:inset 3px 0 #36ff67,inset 0 0 17px #06ec5255,0 0 8px #00e85c88}
