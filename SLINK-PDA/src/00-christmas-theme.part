 ${scope('.groups')},${scope('.tabs')},${scope('.primary-nav')},${scope('.secondary-nav')},${scope('.dashboard-tabs')},${scope('.efficiency-tabs')},${scope('.quality-tabs')}{background:#06080588!important;gap:8px;padding-inline:20px;min-width:0;box-sizing:border-box;flex-wrap:wrap}
