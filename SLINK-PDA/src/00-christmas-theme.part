(function installChristmasTheme(global){
 'use strict';
 const definition={"id":"slink-naughty-list","label":"Naughty List · Christmas 2026","description":"Santa’s Ledger of Illicit Naughty Knowledge. Black ice, gold chains and crimson/emerald Christmas lighting.","scope":"slink.theme.christmas2026","ornament":"none","swatch":["#080b0e","#f21d35","#11bd56"],"tokens":{"--slink-bg":"#080b0e","--slink-bg-raised":"#151b20","--slink-bg-control":"#1b252b","--slink-surface":"#10171c","--slink-card":"#080e12","--slink-control":"#1b252b","--slink-border":"#83949f","--slink-border-soft":"rgba(189,201,210,.3)","--slink-text":"#f4f6f7","--slink-muted":"#aab8c2","--slink-accent":"#f21d35","--slink-accent-alt":"#d9f5ff","--slink-ready":"#67ff6f","--slink-warning":"#ffe2a7","--slink-error":"#ffb6b9","--slink-danger-bg":"#54101d","--slink-link":"#bce9ff","--slink-shadow":"rgba(0,0,0,.5)","--slink-page-bg":"linear-gradient(135deg,#07090c,#141b21 55%,#080b0e)","--slink-topbar-bg":"linear-gradient(115deg,rgba(6,9,12,.96),rgba(31,37,41,.9))","--slink-panel-bg":"rgba(8,14,18,.94)","--slink-button-bg":"linear-gradient(165deg,#303b42,#11181d 45%,#06090d)","--slink-selected-bg":"linear-gradient(110deg,#701525,#a0182e 60%,#213d32)","--slink-mark-bg":"linear-gradient(145deg,#182126,#07090b)","--slink-glow-left":"rgba(168,21,45,.16)","--slink-glow-right":"rgba(32,97,71,.12)","--slink-metal":"#bdc9d2","--slink-metal-dark":"#343f47"},"assets":{"background":"https://raw.githubusercontent.com/Considious/SLINK-Cloudflare-Services/main/themes/assets/christmas2026-background.webp","brandIcon":"https://raw.githubusercontent.com/Considious/SLINK-Cloudflare-Services/main/themes/assets/christmas2026-brand.svg","chatIcon":"https://raw.githubusercontent.com/Considious/SLINK-Cloudflare-Services/main/themes/assets/christmas2026-brand.svg","frame":"https://raw.githubusercontent.com/Considious/SLINK-Cloudflare-Services/main/themes/assets/christmas2026-frame.webp","packaged":true}};
 const files={"background":"christmas2026-background.webp","brand":"christmas2026-brand.svg","frame":"christmas2026-frame.webp","buttonChain":"christmas2026-buttonChain.webp","sideRail":"christmas2026-sideRail.webp","note":"christmas2026-note.webp","prop_medical":"christmas2026-prop-medical.webp","prop_drug":"christmas2026-prop-drug.webp","prop_booster":"christmas2026-prop-booster.webp","prop_casino":"christmas2026-prop-casino.webp","prop_addiction":"christmas2026-prop-addiction.webp","prop_shopping":"christmas2026-prop-shopping.webp","prop_flight":"christmas2026-prop-flight.webp","prop_racing":"christmas2026-prop-racing.webp","prop_education":"christmas2026-prop-education.webp","prop_stocks":"christmas2026-prop-stocks.webp","prop_oc":"christmas2026-prop-oc.webp","prop_market":"christmas2026-prop-market.webp"};
 const url=key=>{const filename=files[key];return global.chrome?.runtime?.getURL?global.chrome.runtime.getURL('assets/themes/'+filename):'https://raw.githubusercontent.com/Considious/SLINK-Cloudflare-Services/main/themes/assets/'+filename;};
 const variable=key=>'url("'+url(key)+'")';
 const selectors={medicalCooldown:'medical',drugCooldown:'drug',boosterCooldown:'booster',energyRefill:'drug',nerveRefill:'booster',casinoTokens:'casino',playerAddiction:'addiction',cityItems:'shopping',landing:'flight',travel:'flight',racing:'racing',education:'education',stockBenefits:'stocks',organizedCrime:'oc'};
 function alertKind(id){const s=String(id||'');return selectors[s]||(/^market|^watch/i.test(s)?'market':/^abroad|^travel|^flight/i.test(s)?'flight':/^rac/i.test(s)?'racing':/^oc[:_-]|^organized/i.test(s)?'oc':/^city-stock/i.test(s)?'shopping':'');}
 function markAlert(card,id){const kind=alertKind(id);if(kind)card.dataset.naughtyAlert=kind;if(id==='energyRefill'||id==='nerveRefill')card.dataset.naughtyRefill=id==='energyRefill'?'energy':'nerve';}
 const state=new WeakMap();
 function apply(host,id,platform='extension'){
  if(!host?.style)return;const root=host.shadowRoot||host.ownerDocument,shadow=!!host.shadowRoot;
  let record=state.get(host);if(!record){record={headers:[]};state.set(host,record);const style=host.ownerDocument.createElement('style');style.dataset.naughtyTheme='';style.textContent=css(shadow?(platform==='pda'?':host([data-theme="slink-naughty-list"])':':host([data-slink-theme="slink-naughty-list"])'):':root[data-slink-theme="slink-naughty-list"]');(shadow?root:root.head).append(style);}
