${contribution.lastSyncAt ? `<div class="module-message">Last sync ${escapeHtml(new Date(contribution.lastSyncAt).toLocaleString())}</div>` : ''}
<div class="target-stack">${rows || moduleMessage('No rough assignments are cached yet. Enable Mugging and press Find targets.')}</div>
</article></div>`;
