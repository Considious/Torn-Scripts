async function refreshCrimeUniqueProgress(force = false) {
const enabled = normalizePdaAlertTypes(dataState.settings.alerts.enabledTypes);
const definitions = PDA_ALERT_TYPES.filter(definition => Number(definition.crimeId) > 0 && enabled[definition.id] !== false);
if (!definitions.length) return dataState.caches.crimeUniques || {};
const now = Date.now();
const previous = dataState.caches.crimeUniques || {};
const cache = { ...previous, user:{ ...(previous.user || {}) }, userFetchedAt:{ ...(previous.userFetchedAt || {}) } };
if (force || !cache.catalog || Number(cache.catalogFetchedAt || 0) + 7 * 86_400_000 <= now) {
cache.catalog = await tornJson('/v2/torn/crimes', 'SLINK PDA crime unique catalog');
cache.catalogFetchedAt = now;
}
for (const definition of definitions) {
if (!force && cache.user[definition.crimeId] && Number(cache.userFetchedAt[definition.crimeId] || 0) + 86_400_000 > now) continue;
cache.user[definition.crimeId] = await tornJson(`/v2/user/${definition.crimeId}/crimes`, `SLINK PDA ${definition.label} progress`);
cache.userFetchedAt[definition.crimeId] = now;
}
dataState.caches.crimeUniques = cache;
for (const progress of crimeUniqueProgressRowsPda()) {
if (!progress.complete || dataState.settings.alerts.enabledTypes[progress.id] === false) continue;
dataState.settings.alerts.enabledTypes[progress.id] = false;
cache.autoDisabledAt = now;
}
return cache;
}
async function refreshCrimeUniqueWindows(force = false) {
if (crimeUniqueRefreshBusy) return;
const enabled = normalizePdaAlertTypes(dataState.settings.alerts.enabledTypes);
const liveEnabled = PDA_ALERT_TYPES.some(definition => definition.mode === 'live' && enabled[definition.id] !== false);
if (!liveEnabled || !currentApiKey() || !hasScope('slink.adhd.alerts')) return;
const cache = dataState.caches.crimeUniques || {};
if (!force && Number(cache.nextLiveAt || 0) > Date.now()) return;
crimeUniqueRefreshBusy = true;
try {
await ensurePermissionSession(false);
const now = Date.now();
const progress = crimeUniqueProgressRowsPda();
const search = progress.find(row => row.id === 'searchCashUnique');
const cluster = progress.find(row => row.id === 'clusterRing');
if (search && !search.complete && enabled.searchCashUnique !== false) {
cache.searchForCashStatus = await tornJson('/v2/torn/searchforcash', 'SLINK PDA Search for Cash unique windows');
cache.searchForCashFetchedAt = now;
}
if (cluster && !cluster.complete && enabled.clusterRing !== false) {
cache.shopliftingStatus = await tornJson('/v2/torn/shoplifting', 'SLINK PDA Shoplifting unique status');
cache.shopliftingFetchedAt = now;
if (!cache.shopliftingSubcrimes || Number(cache.shopliftingSubcrimesFetchedAt || 0) + 7 * 86_400_000 <= now) {
cache.shopliftingSubcrimes = await tornJson('/v2/torn/4/subcrimes', 'SLINK PDA Shoplifting unique map');
cache.shopliftingSubcrimesFetchedAt = now;
}
}
cache.nextLiveAt = now + 60_000;
cache.lastError = '';
dataState.caches.crimeUniques = cache;
reconcileAlertNotifications(moduleState.alerts.data);
writeDataState();
renderAlerts();
} catch (error) {
cache.nextLiveAt = Date.now() + 60_000;
cache.lastError = errorMessage(error);
dataState.caches.crimeUniques = cache;
writeDataState();
} finally {
crimeUniqueRefreshBusy = false;
}
}
function alertRows(snapshot) {
const body = snapshot?.body || {};
const fetchedAt = Number(snapshot?.at) || 0;
const snapshotFresh = fetchedAt > 0 && Date.now() - fetchedAt <= 15 * 60_000;
const snoozed = dataState.settings.alerts.snoozedUntil || {};
const rows = [];
const add = (id, active, title, detail, links = []) => {
if (id !== 'timer24' && !snapshotFresh) return;
if (dataState.settings.alerts.enabledTypes?.[id] === false) return;
if (Number(dataState.settings.alerts.stackModeSince) > 0 && ['energyFull', 'energyRefill'].includes(id)) return;
if (active && Number(snoozed[id] || 0) <= Date.now()) rows.push({ id, title, detail, links });
};
const energy = body?.bars?.energy || {};
const nerve = body?.bars?.nerve || {};
const drug = cooldownSeconds(body, 'drug', fetchedAt);
const medical = cooldownSeconds(body, 'medical', fetchedAt);
const booster = cooldownSeconds(body, 'booster', fetchedAt);
