 const sharedCss="/* Candy Cartel, scoped to this draft. No filters/animations/polling over the full page. */\n.theme-candy-cartel{--candy-gold:#efc36c;--candy-violet:#a743ff;--candy-lime:#b0ee35;border-color:#b98c48;border-radius:18px;background:#140e16;box-shadow:0 0 28px #7d20b449,0 12px 48px #0009}\n.theme-candy-cartel.theme-surface::before{background:none}\n.theme-candy-cartel .theme-art{background-image:var(--slink-theme-background-image);background-position:center top;background-size:100% auto;background-repeat:repeat-y;opacity:1}\n.theme-candy-cartel .mock-header{min-height:196px;padding:24px 36px;align-items:flex-start;background:linear-gradient(180deg,#150b1b30,#150b1b25 65%,#150b1bda);border-color:#ae7d3b}\n.theme-candy-cartel .mock-header>div{padding-top:22px;text-shadow:0 2px 4px #000,0 0 12px #000}\n.theme-candy-cartel .mock-header strong{font-size:38px;letter-spacing:.06em;color:#fff3cb}\n.theme-candy-cartel .mock-header small{font-size:11px;line-height:1.5;max-width:260px;color:#ffe7ad;letter-spacing:.08em}\n.theme-candy-cartel .mock-header .brand-mark{width:112px;height:112px;background:var(--slink-theme-brand-icon) center/contain no-repeat;border:0;box-shadow:none;border-radius:0;flex-shrink:0;color:transparent}\n.theme-candy-cartel .mock-header button{margin-top:19px}\n.theme-candy-cartel .mock-content{padding:26px 34px}\n.theme-candy-cartel .module-tabs,.theme-candy-cartel .section-tabs{padding:14px 32px;background:linear-gradient(110deg,#25102dde,#120b18ed);border-color:#b18545;gap:10px}\n.theme-candy-cartel .section-tabs button{min-height:76px;flex-wrap:wrap;font-weight:650}\n.theme-candy-cartel .module-tabs button{padding:9px 15px;font-weight:600}\n.theme-candy-cartel button,.theme-candy-cartel select,.theme-candy-cartel input:not([type=checkbox]){background:linear-gradient(135deg,#5b2e68,#211128 60%,#392519);border-color:#b68642;color:#fff0d1;border-radius:10px;position:relative}\n.theme-candy-cartel button::before,.theme-candy-cartel .candy-select-shell::before{content:\"\";position:absolute;inset:-3px;border:10px solid transparent;border-image:var(--candy-button-frame) 16% / 10px / 0 round;pointer-events:none;border-radius:inherit;z-index:1}\n.theme-candy-cartel .candy-select-shell{position:relative;display:inline-flex;max-width:100%;min-width:0;border-radius:10px;vertical-align:middle}\n.theme-candy-cartel .candy-select-shell select{max-width:100%;min-width:0;margin:0;border-color:transparent;background:linear-gradient(135deg,#41252e,#1d0f25);padding:7px 14px;min-height:34px}\n.theme-candy-cartel select option{background:#24142b;color:#fff0d1}\n.theme-candy-cartel button[aria-pressed=true]{background:linear-gradient(120deg,#822cbe,#4b146b 60%,#375516);box-shadow:0 0 16px #ac3fff88,inset 0 0 15px #b226f53a;border-color:#f2cf8d}\n.theme-candy-cartel .section-tabs button:nth-child(2n)[aria-pressed=true]{background:linear-gradient(120deg,#425717,#351246 65%,#621d91);box-shadow:0 0 18px #96d13255}\n.theme-candy-cartel button:hover{filter:brightness(1.16)}\n.theme-candy-cartel button:focus-visible,.theme-candy-cartel select:focus-visible,.theme-candy-cartel input:focus-visible{outline:2px solid #d5ff73;outline-offset:5px}\n.theme-candy-cartel button:disabled{filter:grayscale(.7);opacity:.45}\n.theme-candy-cartel input[type=checkbox]{accent-color:#9341d8}\n.theme-candy-cartel .mock-alert,.theme-candy-cartel .mock-metrics>div,.theme-candy-cartel .mock-control-grid,.theme-candy-cartel .chat-example{position:relative;border:1px solid #ba934a;border-radius:13px;background:linear-gradient(125deg,#51126833,#0d0a1126 62%,#612b362e),color-mix(in srgb,#160d1d calc(var(--panel-alpha)*100%),transparent);box-shadow:0 0 14px #9c2bdc44,inset 0 0 20px #49116c44}\n.theme-candy-cartel .mock-alert::before,.theme-candy-cartel .mock-metrics>div::before,.theme-candy-cartel .mock-control-grid::before,.theme-candy-cartel .chat-example::before{content:\"\";position:absolute;inset:-5px;border:20px solid transparent;border-image:var(--candy-frame) 16% / 20px / 0 round;pointer-events:none;z-index:1}\n.theme-candy-cartel .mock-alert{--candy-alert-start:#6b229ab3;--candy-alert-end:#8b173bba;--candy-glow-start:#a22cfa66;--candy-glow-end:#ef315c66;padding:23px 22px;margin-top:24px;background:linear-gradient(112deg,var(--candy-alert-start),#35104788 45%,var(--candy-alert-end)),color-mix(in srgb,#160d1d calc(var(--panel-alpha)*100%),transparent);box-shadow:-3px 0 17px var(--candy-glow-start),3px 0 17px var(--candy-glow-end),inset 0 0 17px #180b2566}\n.theme-candy-cartel .mock-alert:nth-of-type(4n+1){--candy-alert-end:#3e681fba;--candy-glow-end:#a0e14466}\n.theme-candy-cartel .mock-alert:nth-of-type(4n+2),.theme-candy-cartel .mock-alert.error{--candy-alert-start:#8b173bba;--candy-alert-end:#6b229ab3;--candy-glow-start:#ef315c66;--candy-glow-end:#a22cfa66}\n.theme-candy-cartel .mock-alert:nth-of-type(4n+3):not(.error){--candy-alert-start:#3e681fba;--candy-alert-end:#6b229ab3;--candy-glow-start:#a0e14466;--candy-glow-end:#a22cfa66}\n.theme-candy-cartel .mock-alert .tag{color:var(--tone,#c8ed76)}\n.theme-candy-cartel .mock-alert p{color:#e1d1e7;line-height:1.55}\n.theme-candy-cartel .mock-alert[data-candy-prop]{min-height:168px;display:grid;grid-template-columns:minmax(0,1fr) 140px;column-gap:16px}\n.theme-candy-cartel .mock-alert[data-candy-prop]>.tag,.theme-candy-cartel .mock-alert[data-candy-prop]>h3,.theme-candy-cartel .mock-alert[data-candy-prop]>p{grid-column:1}\n.theme-candy-cartel .candy-prop{grid-column:2;grid-row:1/4;position:relative;width:140px;height:120px;align-self:start;pointer-events:none;filter:drop-shadow(0 3px 6px #0009)}\n.theme-candy-cartel .candy-prop>img{display:block;width:100%;height:100%;object-fit:contain}\n.theme-candy-cartel .candy-prop-emblem{position:absolute;right:0;bottom:0;display:grid;place-items:center;width:28px;height:28px;border:2px solid #e4b654;border-radius:50%;background:#1d0c25;box-shadow:0 1px 5px #0008}\n.theme-candy-cartel .candy-prop-emblem svg{width:20px;height:20px;fill:#aeef50}\n.theme-candy-cartel .candy-prop-emblem[data-emblem=flame] svg{fill:#ff5373}\n.theme-candy-cartel .mock-alert[data-candy-prop] .action-row{grid-column:1/-1;position:relative;padding-top:10px;margin-top:12px;min-height:38px}\n.theme-candy-cartel .mock-metrics{gap:18px;margin-block:22px 27px}\n.theme-candy-cartel .mock-metrics>div{padding:21px 12px;background:linear-gradient(125deg,#531675bd,#1a1125 52%,#30481ac7);box-shadow:0 0 12px #9844e34d}\n.theme-candy-cartel .mock-metrics>div:nth-child(2){background:linear-gradient(120deg,#3d5019bd,#1c1225 52%,#5c2338c7)}\n.theme-candy-cartel .mock-metrics strong{color:#fff3d7;font-size:24px}\n.theme-candy-cartel .mock-metrics small{color:#e3cee8}\n.theme-candy-cartel .panel-heading{padding:0 5px}\n.theme-candy-cartel .panel-heading h2{color:#fff2d4;text-shadow:0 0 12px #b957ff6b}\n.theme-candy-cartel .chat-example{margin:5px 34px 25px}\n.theme-candy-cartel .mock-control-grid{padding:20px}\n.theme-candy-cartel .chat-heading{background:linear-gradient(100deg,#5a2183,#281338 70%,#3b4d1b)}\n.theme-candy-cartel .mock-chat-bar{padding-inline:34px;background:#1b0f24e8}\n.theme-candy-cartel .room-shortcut{background:linear-gradient(135deg,#7626a7,#32133f 60%,#4b3d1f);border-color:#d8ac57}\n.theme-candy-cartel .candy-rail{position:absolute!important;top:0;bottom:0;width:76px;background-position:top center;background-size:76px auto;background-repeat:repeat-y;pointer-events:none;z-index:6!important}\n.theme-candy-cartel .candy-rail--left{left:-24px}\n.theme-candy-cartel .candy-rail--right{right:-24px;transform:scaleX(-1)}\n.theme-candy-cartel .nav-icon svg,.theme-candy-cartel .candy-button-icon svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linejoin:round;stroke-linecap:round;color:#f5d28d}\n.theme-candy-cartel .candy-button-icon{display:inline-flex;vertical-align:middle;margin-right:7px}\n.theme-candy-cartel .action-row .candy-button-icon svg{width:15px;height:15px}\n.theme-candy-cartel .section-tabs .nav-icon{display:inline-flex}\n.theme-candy-cartel .count{background:#651d87;border-color:#f1d98c;color:#fff3c4}\n@media(max-width:760px){\n .theme-candy-cartel .mock-header,.theme-candy-cartel[data-layout=pda] .mock-header{padding:18px 27px;gap:9px;min-height:175px}\n .theme-candy-cartel .mock-header .brand-mark{width:80px;height:92px}\n .theme-candy-cartel .mock-header>div{padding-top:16px}\n .theme-candy-cartel .mock-header strong{font-size:27px}\n .theme-candy-cartel .mock-header small{font-size:9px;letter-spacing:.04em}\n .theme-candy-cartel .mock-header button{width:29px;min-width:29px;margin-top:19px}\n .theme-candy-cartel .mock-content,.theme-candy-cartel[data-layout=pda] .mock-content{padding:20px 26px}\n .theme-candy-cartel .section-tabs,.theme-candy-cartel .module-tabs{padding-inline:26px;gap:9px}\n .theme-candy-cartel .section-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}\n .theme-candy-cartel .section-tabs button{min-height:70px;flex-direction:row;font-size:11px}\n .theme-candy-cartel .mock-alert{padding:20px 15px}\n .theme-candy-cartel .mock-alert[data-candy-prop]{grid-template-columns:minmax(0,1fr) 78px;column-gap:12px;min-height:195px}\n .theme-candy-cartel .candy-prop{width:78px;height:97px}\n .theme-candy-cartel .mock-alert[data-candy-prop] .action-row{margin-top:18px;padding-top:6px}\n .theme-candy-cartel .mock-metrics{gap:12px}\n .theme-candy-cartel .mock-metrics>div{padding:17px 6px}\n .theme-candy-cartel .mock-metrics strong{font-size:17px}\n .theme-candy-cartel .mock-metrics small{font-size:10px}\n .theme-candy-cartel .chat-example,.theme-candy-cartel[data-layout=pda] .chat-example{margin-inline:26px}\n .theme-candy-cartel .mock-chat-bar{padding-inline:26px;gap:5px;flex-wrap:wrap}\n .theme-candy-cartel .mock-control-grid{padding:16px}\n}\n/* A manually selected PDA preview keeps the same mobile rules even on a wide screen. */\n.theme-candy-cartel[data-layout=pda] .mock-header{padding:18px 27px;min-height:175px;gap:9px}\n.theme-candy-cartel[data-layout=pda] .mock-header .brand-mark{width:80px;height:92px}\n.theme-candy-cartel[data-layout=pda] .mock-header strong{font-size:27px}\n.theme-candy-cartel[data-layout=pda] .mock-header small{font-size:9px;letter-spacing:.04em}\n.theme-candy-cartel[data-layout=pda] .mock-header>div{padding-top:16px}\n.theme-candy-cartel[data-layout=pda] .mock-alert[data-candy-prop]{grid-template-columns:minmax(0,1fr) 78px;column-gap:12px;min-height:195px}\n.theme-candy-cartel[data-layout=pda] .candy-prop{width:78px;height:97px}\n.theme-candy-cartel[data-layout=pda] .mock-alert[data-candy-prop] .action-row{margin-top:18px}\n.theme-candy-cartel[data-layout=pda] .section-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}\n";
 const icons={"combat":"M5 3l16 16-3 3L2 6V2h4M16 3l5-1v5L5 22l-3-3L16 3","efficiency":"M4 8h16v13H4V8M2 4h20v4H2V4M12 4v17M12 4C8-3 1 5 12 4M12 4c4-7 11 1 0 0","qol":"M3 7l4-4h10l4 4-9 14L3 7h18M7 3l5 18 5-18","access":"M12 3l3 4 5 1-1 5 1 5-5 1-3 4-3-4-5-1 1-5-1-5 5-1 3-4M16 13a4 4 0 1 0-8 0 4 4 0 0 0 8 0","refresh":"M20 9a8 8 0 1 0 0 7M20 3v6h-6","open":"M13 3h8v8M21 3L10 14M10 5H4v16h16v-6","dismiss":"M5 5l14 14M19 5L5 19","bell":"M5 17h14l-2-4V9a5 5 0 0 0-10 0v4l-2 4M10 21h4","market":"M3 21V11h4v10M10 21V6h4v15M17 21V2h4v19","crimes":"M8 14c-5-3-1-9 4-12-1 5 8 6 7 12a7 7 0 0 1-14 0M10 20c-3-3 0-5 2-7 0 3 5 4 2 7","merits":"M12 2l3 7h7l-6 5 2 8-6-5-6 5 2-8-6-5h7l3-7","chat":"M3 3h18v13H9l-6 5V3"};
 const states=new WeakMap();
 const remote='https://raw.githubusercontent.com/Considious/SLINK-Cloudflare-Services/main/themes/assets/';
 const url=key=>global.chrome?.runtime?.getURL?global.chrome.runtime.getURL('assets/themes/'+files[key]):remote+files[key];
 const kinds={medicalCooldown:'medical',drugCooldown:'drug',boosterCooldown:'booster',energyRefill:'drug',nerveRefill:'booster',casinoTokens:'casino',playerAddiction:'addiction',cityItem:'shopping',cityItems:'shopping',landing:'flight',travel:'flight',racing:'racing',education:'education',stockBenefits:'stocks',organizedCrime:'oc'};
 function alertKind(id){const s=String(id||'');return kinds[s]||(/^market|^watch/i.test(s)?'market':/^abroad|^travel|^flight/i.test(s)?'flight':/^rac/i.test(s)?'racing':/^oc[:_-]|^organized/i.test(s)?'oc':'');}
 function markAlert(card,id){card.dataset.candyKind=alertKind(id);if(id==='energyRefill'||id==='nerveRefill')card.dataset.candyRefill=id==='energyRefill'?'lightning':'flame';}
 function refresh(host,subtree){
  const state=states.get(host);if(!state?.active)return;
  const root=host.shadowRoot||host.ownerDocument,scope=subtree||root;
  for(const [node,undo]of state.undo)if(!root.contains(node)){undo();state.undo.delete(node);}
  const remember=(node,fn)=>{const previous=state.undo.get(node);state.undo.set(node,()=>{fn();previous?.();});};
  const cls=(node,name)=>{if(!node||node.classList.contains(name))return;node.classList.add(name);remember(node,()=>node.classList.remove(name));};
  const surfaces=host.shadowRoot?[root.querySelector('.window.main,.overlay')].filter(Boolean):[root.body];
  const computed=global.getComputedStyle(host),opacity=parseFloat(computed.getPropertyValue('--slink-theme-panel-opacity')||computed.getPropertyValue('--s-theme-panel-opacity'));
  for(const surface of surfaces)surface.style.setProperty('--panel-alpha',String(Number.isFinite(opacity)?Math.max(0,Math.min(100,opacity))/100:.9));
  for(const surface of surfaces){
   cls(surface,'theme-candy-cartel');
   if(!surface.querySelector(':scope>.candy-live-wall')){
    const wall=surface.ownerDocument.createElement('div');wall.className='theme-art candy-live-wall';wall.setAttribute('aria-hidden','true');surface.prepend(wall);remember(surface,()=>wall.remove());
    for(const side of ['left','right']){const rail=surface.ownerDocument.createElement('div');rail.className='candy-rail candy-rail--'+side;rail.setAttribute('aria-hidden','true');rail.style.backgroundImage='url("'+url('rail')+'")';surface.append(rail);remember(surface,()=>rail.remove());}
   }
  }
  const aliases={'.head,.topbar':'mock-header','.mark,.brand-mark,.topbar .brand>span:first-child':'brand-mark','.groups,.primary-nav,.dashboard-tabs':'section-tabs','.tabs,.subnav,.efficiency-tabs,.quality-tabs':'module-tabs','.slink-adhd-summary,.compact-stats,.stats':'mock-metrics','.slink-adhd-links,.adhd-alert-actions,.target-actions':'action-row'};
  for(const [selector,name]of Object.entries(aliases))for(const node of scope.querySelectorAll(selector))cls(node,name);
  for(const card of scope.querySelectorAll('.slink-adhd-alert,.adhd-alert-card,.alert-list>.alert')){
   cls(card,'mock-alert');const kind=card.dataset.candyKind||card.dataset.naughtyAlert;
   if(!kind||!files['prop_'+kind]||card.querySelector(':scope>.candy-prop'))continue;
   const old=card.getAttribute('data-candy-prop');card.dataset.candyProp=kind;remember(card,()=>old===null?card.removeAttribute('data-candy-prop'):card.setAttribute('data-candy-prop',old));
   const art=card.ownerDocument.createElement('span');art.className='candy-prop';art.setAttribute('aria-hidden','true');
   const img=card.ownerDocument.createElement('img');img.src=url('prop_'+kind);img.alt='';img.width=320;img.height=320;img.decoding='async';art.append(img);
   const refill=card.dataset.candyRefill||({energy:'lightning',nerve:'flame'}[card.dataset.naughtyRefill]);
   if(refill){const badge=card.ownerDocument.createElement('span');badge.className='candy-prop-emblem';badge.dataset.emblem=refill;badge.textContent=refill==='lightning'?'ϟ':'♨';art.append(badge);}
   card.append(art);remember(card,()=>art.remove());
  }
  for(const select of scope.querySelectorAll('select'))if(!select.parentElement.classList.contains('candy-select-shell')){
   const shell=select.ownerDocument.createElement('span');shell.className='candy-select-shell';select.before(shell);shell.append(select);remember(select,()=>shell.replaceWith(select));
  }
  for(const button of scope.querySelectorAll('button')){
   if(button.querySelector('[data-candy-live-icon]'))continue;
   const label=button.textContent.trim(),key=Object.entries({Combat:'combat',Efficiency:'efficiency','Quality of Life':'qol',Access:'access',Alerts:'bell',Market:'market',Crimes:'crimes',Merits:'merits',Refresh:'refresh',Open:'open',Dismiss:'dismiss'}).find(([text])=>label.startsWith(text))?.[1];if(!icons[key])continue;
   const span=button.ownerDocument.createElement('span');span.className='candy-button-icon';span.dataset.candyLiveIcon='';span.setAttribute('aria-hidden','true');span.innerHTML='<svg viewBox="0 0 24 24"><path d="'+icons[key]+'"/></svg>';button.prepend(span);remember(button,()=>span.remove());
  }
  for(const [selector,text]of [['.head .title,.topbar h1,.topbar .brand strong','SLINK'],['.head .subtitle,.topbar .brand p,.topbar .brand>span','Sugar Logistics & Illicit Network of Kriminals']]){
   const node=selector.split(',').map(s=>root.querySelector(s)).find(Boolean);if(node&&!node.dataset.candyHeader){const old=node.textContent;node.textContent=text;node.dataset.candyHeader='';remember(node,()=>{if(node.textContent===text)node.textContent=old;delete node.dataset.candyHeader;});}
  }
 }
 function apply(host,id){
  if(!host?.ownerDocument)return;let state=states.get(host);
  const root=host.shadowRoot||host.ownerDocument;
  if(!state){const style=host.ownerDocument.createElement('style');style.dataset.candyRuntime='';style.textContent=sharedCss+`
   .theme-candy-cartel{isolation:isolate;--panel-alpha:.9;--slink-theme-background-image:url("${url('background')}");--slink-theme-brand-icon:url("${url('brand')}");--candy-frame:url("${url('frame')}");--candy-button-frame:url("${url('button')}")}
   .window.main.theme-candy-cartel,.overlay.theme-candy-cartel{background:#140e16!important}
   .theme-candy-cartel .candy-live-wall{position:absolute;inset:0;z-index:-1;pointer-events:none;border-radius:inherit}
   body.theme-candy-cartel{position:relative;min-height:100vh}
   .theme-candy-cartel :is(.groups,.tabs,.primary-nav,.subnav){overflow:visible}
   .theme-candy-cartel :is(.head,.topbar){box-sizing:border-box;min-height:110px!important;align-items:flex-start!important;background:#150b1b66!important;padding-block:12px!important}
   .theme-candy-cartel :is(.head,.topbar) .brand-mark{width:70px!important;min-width:70px;height:78px!important}
   .theme-candy-cartel .head .heading,.theme-candy-cartel .topbar .brand{padding-top:14px;min-width:0;flex:1}
   .theme-candy-cartel :is(.title,.brand strong,.topbar h1){font-size:23px;line-height:1.2;color:#fff3cb}
   .theme-candy-cartel :is(.subtitle,.brand>span,.brand p){display:block;font-size:10px;line-height:1.4;color:#ffe7ad;overflow-wrap:anywhere;white-space:normal!important;overflow:visible!important;text-overflow:clip!important}
   .theme-candy-cartel .mock-alert{box-sizing:border-box;overflow:visible!important;font:12px/1.5 Arial,sans-serif}
   .theme-candy-cartel .mock-alert>strong{grid-column:1;font-size:15px;line-height:1.4}
   .theme-candy-cartel .mock-alert>span:not(.candy-prop){grid-column:1;color:#ddcbe1}
   .theme-candy-cartel .mock-alert>div:not(.action-row){grid-column:1;min-width:0}
   .theme-candy-cartel .mock-alert[data-candy-prop]{grid-template-columns:minmax(0,1fr) clamp(70px,25%,120px)}
   .theme-candy-cartel .mock-alert .candy-prop{width:100%;height:105px}
   .theme-candy-cartel .mock-alert .action-row{display:flex;flex-wrap:wrap;gap:8px;grid-column:1/-1;width:100%;min-width:0}
   .theme-candy-cartel .mock-alert .action-row>a{position:relative;padding:6px 12px;background:var(--slink-button-bg);border:8px solid transparent;border-image:var(--candy-button-frame) 16% / 8px / 0 round;color:#fff0d1;text-decoration:none}
   .theme-candy-cartel .mock-metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(80px,1fr))}
   .theme-candy-cartel .mock-metrics>div{min-width:0;box-sizing:border-box}
   .theme-candy-cartel .theme-content-shell{position:relative;background:transparent!important}
   .theme-candy-cartel .scroll{background:transparent!important;padding-inline:26px!important}
   .theme-candy-cartel .slink-adhd-list{gap:8px}
   .theme-candy-cartel .slink-adhd-summary{padding:0 6px}
   .theme-candy-cartel .mock-alert .candy-prop{margin:0!important}
   .theme-candy-cartel .section-tabs{box-sizing:border-box;flex-wrap:wrap}
   .theme-candy-cartel .section-tabs button{min-width:0;flex:1;box-sizing:border-box}
   .theme-candy-cartel .module-view>.content{padding-inline:26px}
   .theme-candy-cartel .module-head,.theme-candy-cartel .status{background:#160d1d9c;padding-inline:26px!important}
   .theme-candy-cartel .actions,.theme-candy-cartel .page-head{padding-inline:26px!important}
   .theme-candy-cartel .groups .group-tab{min-height:36px}
   .theme-candy-cartel .primary-nav{grid-template-columns:repeat(4,minmax(0,1fr))!important}
   .theme-candy-cartel .primary-nav button{min-height:50px;font-size:11px;padding:6px}
   .theme-candy-cartel .module-tabs button{padding:7px 9px}
   .theme-candy-cartel .mock-alert>div>strong{font-size:15px}
   `;(host.shadowRoot||root.head).append(style);state={active:false,undo:new Map(),style};states.set(host,state);}
  if(id!==definition.id){for(const undo of state.undo.values())undo();state.undo.clear();state.active=false;return;}
  state.active=true;
  for(const surface of host.shadowRoot?[root.querySelector('.window.main,.overlay')].filter(Boolean):[root.body])if(!surface.dataset.candyTokens){
   const previous=[...Object.keys(definition.tokens),'--panel-alpha'].map(name=>[name,surface.style.getPropertyValue(name)]),undo=state.undo.get(surface);surface.dataset.candyTokens='';
   for(const [name,value]of Object.entries(definition.tokens))surface.style.setProperty(name,value);
   state.undo.set(surface,()=>{for(const [name,value]of previous)value?surface.style.setProperty(name,value):surface.style.removeProperty(name);delete surface.dataset.candyTokens;undo?.();});
  }
  refresh(host);
 }
 global.SLINK_CANDY_THEME=Object.freeze({definition,files,apply,refresh,markAlert,alertKind,css:sharedCss});
})(globalThis);

