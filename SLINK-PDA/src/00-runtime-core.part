name:profile?.name,
level:profile?.level,
state:status?.state,
until:status?.until,
description:status?.description,
bountyCount:bounties.length,
bountyTotal:bounties.reduce((total, bounty) => total + Math.max(0, Number(bounty?.reward) || 0), 0),
