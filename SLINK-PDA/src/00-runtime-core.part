const SHARED_API_LEDGER_KEY = 'considious:torn-api-ledger:v1';
const SHARED_API_LOCK = 'considious-torn-api-limiter-v1';
const ROOT_OVERFLOW_KEY = 'slinkPdaPreviousOverflow';
const API_WINDOW_MS = 60_000;
const API_LIMIT = 60;
const MODULE_INACTIVE_AFTER_MS = 5 * 60_000;
const CONTRIBUTION_CEILING = 40;
const CONTRIBUTION_INTERACTIVE_RESERVE = 10;
const CLIENT_NAME = 'SLINK PDA Dashboard';
const CLIENT_VERSION = '0.4.55';
const WEEK_MS = 7 * 86_400_000;
const PDA_ALERT_TYPES = Object.freeze([
{ id:'drugCooldown', label:'Drug cooldown clear', group:'Cooldowns' },
{ id:'medicalCooldown', label:'Medical cooldown clear', group:'Cooldowns' },
{ id:'boosterCooldown', label:'Booster cooldown clear', group:'Cooldowns' },
{ id:'energyFull', label:'Energy full', group:'Bars & refills' },
{ id:'nerveFull', label:'Nerve full', group:'Bars & refills' },
{ id:'energyRefill', label:'Energy refill unused', group:'Bars & refills' },
{ id:'nerveRefill', label:'Nerve refill unused', group:'Bars & refills' },
{ id:'raceOrFly', label:'Start a race or take a flight', group:'Travel & racing' },
{ id:'landing', label:'Landing soon', group:'Travel & racing' },
{ id:'missions', label:'Unfinished missions', group:'Daily activity' },
{ id:'cityItems', label:'Buy 100 city items', group:'Daily activity' },
{ id:'organizedCrime', label:'Join an organized crime', group:'Daily activity' },
{ id:'education', label:'Start an education course', group:'Daily activity' },
{ id:'casinoTokens', label:'Spend casino tokens', group:'Daily activity' },
{ id:'stockBenefits', label:'Stock benefit ready', group:'Benefits' },
{ id:'playerAddiction', label:'Player addiction', group:'Benefits' },
{ id:'googlePlayPoints', label:'Weekly Google Play Points', group:'Reminders' },
{ id:'timer24', label:'24-hour timer finished', group:'Reminders' }
]);
function normalizePdaAlertTypes(value) {
const source = value && typeof value === 'object' ? value : {};
return Object.fromEntries(PDA_ALERT_TYPES.map(definition => [definition.id, source[definition.id] !== false]));
}
const GOOGLE_PLAY_POINTS_HELP_URL = 'https://support.google.com/googleplay/answer/9077192';
const GOOGLE_PLAY_POINTS_ANDROID_INTENT = `intent://play.google.com/store/points#Intent;scheme=https;package=com.android.vending;S.browser_fallback_url=${encodeURIComponent(GOOGLE_PLAY_POINTS_HELP_URL)};end`;
const URLS = Object.freeze({
permission:'https://slinkcontributionworker.richard-johnson554.workers.dev',
leveling:'https://slinkyleveling.richard-johnson554.workers.dev',
war:'https://slinkwarworker.richard-johnson554.workers.dev',
mugging:'https://slinkmuggingworker.richard-johnson554.workers.dev',
torn:'https://api.torn.com',
weaver:'https://weav3r.dev'
});
const BOUNTY_SCOPE = 'slink.combat.bounties';
const PLAYER_STATS_SCOPE = 'slink.combat.player-stats';
const TARGET_LIST_SCOPE = 'slink.combat.target-list';
const MERITS_SCOPE = 'slink.efficiency.merits';
const DOLLAR_BAZAARS_SCOPE = 'slink.efficiency.dollar-bazaars';
const RACING_SCOPE = 'slink.qol.racing';
const ABROAD_STOCKS_SCOPE = 'slink.qol.abroad-stocks';
const TRAVEL_SAFETY_BUFFER_RATIO = 0.10;
const TRAVEL_SAFETY_CACHE_MS = 2 * 60_000;
const COMPANY_SCOPE = 'slink.qol.company';
const COMPANY_CACHE_MS = 15 * 60_000;

const MUSEUM_SCOPE='slink.qol.museum',MUSEUM_CACHE_MS=3600000,MUSEUM_CATALOG_MS=604800000;
const museumItem=(name,amount=1)=>({name,amount});
const MUSEUM_SETS=[
{id:'plushies',name:'Plushie Set',points:10,travel:true,items:['Jaguar Plushie','Lion Plushie','Panda Plushie','Monkey Plushie','Chamois Plushie','Wolverine Plushie','Nessie Plushie','Red Fox Plushie','Camel Plushie','Kitten Plushie','Teddy Bear Plushie','Sheep Plushie','Stingray Plushie'].map(museumItem)},
{id:'flowers',name:'Exotic Flower Set',points:10,travel:true,items:['Dahlia','Orchid','African Violet','Cherry Blossom','Peony','Ceibo Flower','Edelweiss','Crocus','Heather','Tribulus Omanense','Banana Orchid'].map(museumItem)},
{id:'meteorite',name:'Meteorite Fragment',points:15,items:[museumItem('Meteorite Fragment')]},
{id:'fossil',name:'Patagonian Fossil',points:20,items:[museumItem('Patagonian Fossil')]},
{id:'arrowheads',name:'Arrowhead Set',points:25,items:['Obsidian Point','Quartz Point','Basalt Point','Chert Point','Chalcedony Point','Quartzite Point'].map(museumItem)},
{id:'medieval-coins',name:'Medieval Coin Set',points:100,items:['Leopard Coin','Florin Coin','Gold Noble Coin'].map(museumItem)},
{id:'vairocana',name:'Vairocana Buddha',points:100,items:[museumItem('Vairocana Buddha Sculpture')]},
{id:'ganesha',name:'Ganesha Sculpture',points:250,items:[museumItem('Ganesha Sculpture')]},
{id:'shabti',name:'Shabti Sculpture',points:500,items:[museumItem('Shabti Sculpture')]},
{id:'companion-scripts',name:'Companion Scripts',points:1000,items:['Companion Script : Abdullah','Companion Script : Ali','Companion Script : Ubay'].map(museumItem)},
{id:'senet',name:'Senet Game Set',points:2000,items:[museumItem('Senet board'),museumItem('White Senet pawn',5),museumItem('Black Senet pawn',5)]},
{id:'amulet',name:'Egyptian Amulet',points:10000,items:[museumItem('Egyptian Amulet')]}
];
const MUSEUM_ALIASES={'quran script : ibn masud':'Companion Script : Abdullah','quran script : ali':'Companion Script : Ali',"quran script : ubay ibn ka'b":'Companion Script : Ubay','script from the quran: ibn masud':'Companion Script : Abdullah','script from the quran: ali':'Companion Script : Ali',"script from the quran: ubay ibn ka'b":'Companion Script : Ubay'};
function museumKey(value){return String(value||'').trim().replace(/\s+/g,' ').toLowerCase()}
function museumName(value){const text=String(value||'').trim().replace(/\s+/g,' ');return MUSEUM_ALIASES[museumKey(text)]||text}
function museumBuildStatus(inventoryRows=[],catalogRows=[]){
const owned=new Map(),catalog=new Map();
for(const row of inventoryRows){const name=museumName(row?.name);if(!name)continue;const key=museumKey(name),prior=owned.get(key)||{id:Number(row?.id)||0,amount:0};prior.amount+=Math.max(0,Math.trunc(Number(row?.amount)||0));owned.set(key,prior)}
for(const row of catalogRows){const name=museumName(row?.name);if(name)catalog.set(museumKey(name),row)}
const sets=MUSEUM_SETS.map(definition=>{const items=definition.items.map(required=>{const inventory=owned.get(museumKey(required.name)),entry=catalog.get(museumKey(required.name)),amount=Number(inventory?.amount)||0,needed=Math.max(0,required.amount-amount);return{name:required.name,required:required.amount,owned:amount,needed,complete:needed===0,itemId:Number(entry?.id||inventory?.id)||0,marketPrice:Math.max(0,Number(entry?.marketPrice)||0)}});const completeSets=Math.min(...items.map(item=>Math.floor(item.owned/item.required)));return{...definition,complete:items.every(item=>item.complete),completeSets:Number.isFinite(completeSets)?completeSets:0,items}});
return{sets,summary:{completed:sets.filter(set=>set.complete).length,total:sets.length,redeemablePoints:sets.reduce((sum,set)=>sum+set.completeSets*set.points,0)}}
}

function companySettings() {
const value = dataState.settings.company || {};
dataState.settings.company = {
enabled:value.enabled !== false,
addictionThreshold:Math.min(100, Math.max(1, Number(value.addictionThreshold) || 10)),
directorThreshold:Math.min(100, Math.max(1, Number(value.directorThreshold) || 10)),
refreshMinutes:Math.min(60, Math.max(5, Number(value.refreshMinutes) || 15))
};
return dataState.settings.company;
}
function companyFinite(value) {
const parsed = Number(value);
return Number.isFinite(parsed) ? parsed : null;
}
function companyAddictionPenalty(employee = {}) {
const value = companyFinite(employee?.effectiveness?.addiction);
return value === null ? null : Math.abs(Math.min(0, value));
}
function normalizeCompanyEmployee(employee = {}) {
const id = Math.trunc(Number(employee.id ?? employee.user_id ?? employee.userId) || 0);
const effectiveness = employee.effectiveness && typeof employee.effectiveness === 'object' ? { ...employee.effectiveness } : null;
const stats = employee.stats && typeof employee.stats === 'object' ? { ...employee.stats } : null;
const workingStats = companyFinite(effectiveness?.working_stats ?? effectiveness?.workingStats);
return {
id,
name:String(employee.name || employee.player_name || `User ${id || '?'}`),
position:String(employee.position || employee.position_name || ''),
daysInCompany:Math.max(0, Math.trunc(Number(employee.days_in_company ?? employee.daysInCompany) || 0)),
effectiveness,
stats,
addictionPenalty:companyAddictionPenalty(employee),
totalEffectiveness:companyFinite(effectiveness?.total),
workingStatsEffectiveness:workingStats,
trainHeadroom:workingStats === null ? null : Math.max(0, 50 - workingStats),
totalStats:stats ? Object.values(stats).reduce((sum, value) => sum + (companyFinite(value) || 0), 0) : null
};
}
function normalizeCompanySnapshot(userResponse = {}, companyResponse = {}, userId = 0) {
const job = userResponse.job || userResponse;
const jobpoints = userResponse.jobpoints || userResponse.job_points || {};
const profile = companyResponse.profile || companyResponse.company || {};
const rawEmployees = Array.isArray(companyResponse.employees) ? companyResponse.employees : Object.values(companyResponse.employees || {});
const employees = rawEmployees.map(normalizeCompanyEmployee).filter(employee => employee.id > 0);
const currentUserId = Math.trunc(Number(userId) || 0);
const directorId = Math.trunc(Number(profile?.director?.id ?? profile?.director_id) || 0);
const companyId = Math.trunc(Number(job?.id ?? job?.company_id ?? job?.company?.id ?? profile?.id) || 0);
const companyTypeId = Math.trunc(Number(job?.company_type ?? job?.type_id ?? job?.company?.type_id ?? profile?.type_id) || 0);
const companyPointRows = Array.isArray(jobpoints?.companies)
? jobpoints.companies
: Object.entries(jobpoints?.companies || {}).map(([id, entry]) => ({
...entry,
company:entry?.company || { id:Number(id), name:entry?.name || '' },
points:entry?.points ?? entry?.jobpoints
}));
const companyPoints = companyPointRows.find(entry => Number(entry?.company?.id ?? entry?.company_id ?? entry?.id) === companyTypeId)
|| companyPointRows.find(entry => key(entry?.company?.name ?? entry?.name) === key(job?.company_type_name ?? job?.company?.type_name ?? profile?.type_name));
return {
fetchedAt:Date.now(),
userId:currentUserId,
director:directorId > 0 && directorId === currentUserId,
directorId,
company:{
id:companyId,
name:String(job?.company_name ?? job?.company?.name ?? profile?.name ?? ''),
typeId:companyTypeId,
rating:Math.trunc(Number(job?.company_rating ?? job?.rating ?? profile?.rating) || 0),
position:String(job?.position || ''),
daysInCompany:Math.max(0, Math.trunc(Number(job?.days_in_company) || 0)),
jobPoints:companyFinite(companyPoints?.points ?? companyPoints?.jobpoints ?? jobpoints?.jobs?.points ?? jobpoints?.points)
},
self:employees.find(employee => employee.id === currentUserId) || null,
employees
};
}
function rankCompanyTrainCandidates(employees = []) {
return [...employees].filter(employee => employee.trainHeadroom !== null).sort((left, right) =>
Number(right.trainHeadroom) - Number(left.trainHeadroom)
|| Number(left.totalStats ?? Number.MAX_SAFE_INTEGER) - Number(right.totalStats ?? Number.MAX_SAFE_INTEGER)
|| left.name.localeCompare(right.name)
);
}
function companyReminderText(employee) {
return `Your addiction penalty is currently ${employee?.addictionPenalty === null ? 'unknown' : '-' + employee.addictionPenalty}. Please rehab as soon as possible.`;
}
function companyAlertRows() {
const snapshot = dataState.caches.company?.snapshot;
const settings = companySettings();
const snoozed = dataState.settings.alerts.snoozedUntil || {};
if (!snapshot || !settings.enabled || !hasScope(COMPANY_SCOPE)) return [];
const rows = [];
const add = row => { if (Number(snoozed[row.id] || 0) <= Date.now()) rows.push(row); };
if (snapshot.self?.addictionPenalty !== null && snapshot.self.addictionPenalty >= settings.addictionThreshold) {
add({ id:'company:addiction:self', title:'Company addiction reminder', detail:`Your company effectiveness addiction penalty is -${snapshot.self.addictionPenalty}. Please rehab as soon as possible.`, links:[['Company','https://www.torn.com/joblist.php']] });
}
if (snapshot.director) {
for (const employee of snapshot.employees || []) {
if (employee.id === snapshot.userId || employee.addictionPenalty === null || employee.addictionPenalty < settings.directorThreshold) continue;
add({
id:`company:addiction:${employee.id}`,
title:`${employee.name} needs rehab`,
detail:`Company effectiveness addiction penalty: -${employee.addictionPenalty}.`,
links:[['Profile',`https://www.torn.com/profiles.php?XID=${employee.id}`],['Message',`https://www.torn.com/messages.php#/p=compose&XID=${employee.id}`]]
});
}
}
return rows;
}
function travelSafetyTimestampMs(value) {
const numberValue = Number(value);
if (!Number.isFinite(numberValue) || numberValue <= 0) return 0;
return numberValue < 10_000_000_000 ? Math.trunc(numberValue * 1000) : Math.trunc(numberValue);
}
function travelSafetyParseDurationMs(value) {
const text = String(value || '').trim();
if (!text) return 0;
let seconds = 0;
let matched = false;
const units = /(\d+(?:\.\d+)?)\s*(?:d(?:ays?)?|h(?:ours?)?|m(?:in(?:ute)?s?)?|s(?:ec(?:ond)?s?)?)(?![a-z])/gi;
for (const match of text.matchAll(units)) {
matched = true;
const amount = Number(match[1]);
const unit = match[0].replace(match[1], '').trim().toLowerCase()[0];
seconds += amount * (unit === 'd' ? 86_400 : unit === 'h' ? 3_600 : unit === 'm' ? 60 : 1);
}
if (matched) return Math.round(seconds * 1000);
const fullClock = text.match(/^(\d+):(\d{1,2}):(\d{2})$/);
if (fullClock) return (Number(fullClock[1]) * 3_600 + Number(fullClock[2]) * 60 + Number(fullClock[3])) * 1000;
const hourMinute = text.match(/^(\d{1,2}):(\d{2})$/);
return hourMinute ? (Number(hourMinute[1]) * 3_600 + Number(hourMinute[2]) * 60) * 1000 : 0;
}
function travelSafetyNormalizeCrime(response) {
const crime = response?.organizedcrime ?? response?.organizedCrime ?? response?.crime ?? response;
if (!crime || typeof crime !== 'object' || Array.isArray(crime)) return null;
const readyAt = travelSafetyTimestampMs(crime.ready_at ?? crime.readyAt);
if (!readyAt) return null;
return {
id:String(crime.id ?? crime.crime_id ?? crime.crimeId ?? ''),
name:String(crime.name ?? crime.title ?? 'Organized crime'),
readyAt,
executedAt:travelSafetyTimestampMs(crime.executed_at ?? crime.executedAt)
};
}
function travelSafetyRoundTripMs(oneWayMs) {
return Math.ceil(Math.max(0, Number(oneWayMs) || 0) * 2 * (1 + TRAVEL_SAFETY_BUFFER_RATIO));
}
function travelSafetyAssessment(oneWayMs, crime, now = Date.now()) {
const roundTripMs = travelSafetyRoundTripMs(oneWayMs);
const readyAt = travelSafetyTimestampMs(crime?.readyAt ?? crime?.ready_at);
const returnAt = now + roundTripMs;
return {
blocked:Boolean(roundTripMs && readyAt > now && !travelSafetyTimestampMs(crime?.executedAt ?? crime?.executed_at) && returnAt > readyAt),
roundTripMs,
returnAt,
readyAt
};
}
function travelSafetyFormatTct(timestamp) {
const value = travelSafetyTimestampMs(timestamp);
if (!value) return 'unknown';
return new Intl.DateTimeFormat('en-US', { timeZone:'UTC', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit', hour12:false }).format(value) + ' TCT';
}
const ABROAD_STOCKS = (() => {
const PROVIDERS = Object.freeze({
yata:Object.freeze({ id:'yata', label:'YATA', url:'https://yata.yt/api/v1/travel/export/' }),
prometheus:Object.freeze({ id:'prometheus', label:'Prometheus', url:'https://prombot.co.uk:8443/api/travel' }),
tornIntel:Object.freeze({ id:'tornIntel', label:'Torn Intel', url:'https://torn-intel.com/api/v1/foreign-stock/travel-table' }),
droqs:Object.freeze({ id:'droqs', label:'DroqsDB forecast', url:'https://droqsdb.com/api/public/v1/restocking-soon', enrichment:true })
});
const COUNTRIES = Object.freeze([
['arg','Argentina',158], ['can','Canada',39], ['cay','Cayman Islands',33],
['chi','China',229], ['haw','Hawaii',127], ['jap','Japan',213],
['mex','Mexico',24], ['sou','South Africa',282], ['swi','Switzerland',175],
['uae','UAE',271], ['uni','United Kingdom',159]
].map(([code,name,minutes]) => Object.freeze({ code, name, minutes })));
const TRAVEL_MULTIPLIERS = Object.freeze({ standard:1, airstrip:0.7, business:0.5, private:0.3 });
const countryByCode = new Map(COUNTRIES.map(country => [country.code, country]));
const countryByName = new Map(COUNTRIES.map(country => [key(country.name), country]));
function key(value) {
return String(value ?? '').trim().replace(/\s+/g, ' ').toLocaleLowerCase();
}
function finite(value) {
if (value === null || value === undefined || value === '') return null;
const number = Number(value);
return Number.isFinite(number) ? number : null;
}
function timestamp(value, fallback = 0) {
if (value === null || value === undefined || value === '') return Math.max(0, Number(fallback) || 0);
if (typeof value === 'string' && !/^\d+(?:\.\d+)?$/.test(value.trim())) {
const parsed = Date.parse(value);
return Number.isFinite(parsed) ? parsed : Math.max(0, Number(fallback) || 0);
}
const number = finite(value);
if (number === null || number <= 0) return Math.max(0, Number(fallback) || 0);
return number < 10_000_000_000 ? Math.round(number * 1000) : Math.round(number);
}
function countryRecord(value) {
const normalized = key(value);
if (!normalized) return null;
const compact = normalized.replace(/[^a-z]/g, '');
return countryByCode.get(compact.slice(0, 3))
|| countryByName.get(normalized)
|| COUNTRIES.find(country => key(country.name).startsWith(normalized) || normalized.startsWith(key(country.name)))
|| null;
}
function rows(value) {
if (Array.isArray(value)) return value;
if (value && typeof value === 'object') return Object.values(value);
return [];
}
function sourceCountries(payload) {
const stocks = payload?.stocks || payload?.data?.stocks || payload?.result?.stocks;
if (stocks && typeof stocks === 'object' && !Array.isArray(stocks)) {
return Object.entries(stocks).map(([country, record]) => ({ country, ...(record || {}) }));
}
for (const candidate of [payload?.countries, payload?.data?.countries, payload?.result?.countries, payload?.data]) {
if (Array.isArray(candidate)) return candidate;
}
return [];
}
function itemTimestamp(item, names, fallback = 0) {
for (const name of names) {
if (item?.[name] !== undefined && item?.[name] !== null) {
const direct = timestamp(item[name]);
if (direct) return direct;
}
}
return timestamp(fallback);
}
function normalizeProvider(providerId, payload, fetchedAt = Date.now()) {
const provider = PROVIDERS[providerId];
if (!provider) throw new Error('Unknown abroad-stock provider.');
const normalized = [];
if (provider.enrichment && Array.isArray(payload?.items)) {
for (const item of payload.items) {
const country = countryRecord(item?.countryCode ?? item?.yataCode ?? item?.country?.yataCode ?? item?.country?.code ?? item?.country?.name ?? item?.countryName ?? item?.country);
if (!country) continue;
const name = String(item?.itemName ?? item?.name ?? item?.item ?? '').trim();
const id = Math.max(0, Math.trunc(finite(item?.itemId ?? item?.id ?? item?.item_id) || 0));
if (!id && !name) continue;
const quantity = finite(item?.quantity ?? item?.stock ?? item?.currentStock ?? item?.current);
const cost = finite(item?.buyPrice ?? item?.cost ?? item?.price ?? item?.foreignPrice);
let nextRestockAt = itemTimestamp(item, ['nextRestockAt','estimatedRestockAt','restockAt','restock_at']);
const estimatedMinutes = finite(item?.estimatedRestockMinutes ?? item?.restockMinutes);
if (!nextRestockAt && estimatedMinutes !== null && estimatedMinutes >= 0) nextRestockAt = timestamp(payload?.generatedAt, fetchedAt) + estimatedMinutes * 60_000;
normalized.push({
provider:providerId,
countryCode:country.code,
countryName:country.name,
itemId:id || null,
itemName:name || ('Item ' + id),
quantity:quantity === null ? null : Math.max(0, Math.trunc(quantity)),
cost:cost === null ? null : Math.max(0, Math.round(cost)),
updatedAt:itemTimestamp(item, ['stockUpdatedAt','updatedAt','lastUpdated','timestamp'], payload?.generatedAt ?? fetchedAt),
lastRestockAt:itemTimestamp(item, ['lastRestockAt','lastRestock','previousRestockAt']),
nextRestockAt,
predictionSource:nextRestockAt ? provider.label : ''
});
}
return normalized;
}
for (const countryInput of sourceCountries(payload || {})) {
const country = countryRecord(countryInput?.country || countryInput?.code || countryInput?.iata || countryInput?.yataCode || countryInput?.name);
if (!country) continue;
const updatedAt = timestamp(
countryInput?.update ?? countryInput?.updatedAt ?? countryInput?.lastUpdated ?? countryInput?.timestamp,
payload?.timestamp ?? payload?.generatedAt ?? fetchedAt
);
const itemRows = rows(countryInput?.stocks || countryInput?.items || countryInput?.inventory || countryInput?.data);
for (const item of itemRows) {
const name = String(item?.name || item?.itemName || item?.item || '').trim();
const id = Math.max(0, Math.trunc(finite(item?.id ?? item?.itemId ?? item?.item_id) || 0));
if (!id && !name) continue;
const quantity = finite(item?.quantity ?? item?.stock ?? item?.current ?? item?.amount);
const cost = finite(item?.cost ?? item?.buyPrice ?? item?.price ?? item?.foreignPrice);
let nextRestockAt = itemTimestamp(item, ['nextRestock','next_restock','nextRestockAt','estimatedRestockAt','estimatedRestockTime','restockAt','restock_at']);
if (!nextRestockAt && finite(item?.estimatedRestockMinutes) !== null) nextRestockAt = fetchedAt + Number(item.estimatedRestockMinutes) * 60_000;
normalized.push({
provider:providerId,
countryCode:country.code,
countryName:country.name,
itemId:id || null,
itemName:name || ('Item ' + id),
quantity:quantity === null ? null : Math.max(0, Math.trunc(quantity)),
cost:cost === null ? null : Math.max(0, Math.round(cost)),
updatedAt,
lastRestockAt:itemTimestamp(item, ['lastRestock','last_restock','lastRestockAt','previousRestockAt']),
nextRestockAt,
predictionSource:nextRestockAt ? provider.label : ''
});
}
}
return normalized;
}
function itemKey(row) {
return String(row.countryCode) + ':' + (row.itemId || key(row.itemName));
}
function median(values) {
const sorted = values.filter(Number.isFinite).sort((a,b) => a-b);
if (!sorted.length) return 0;
const middle = Math.floor(sorted.length / 2);
return sorted.length % 2 ? sorted[middle] : Math.round((sorted[middle - 1] + sorted[middle]) / 2);
}
function historyPrediction(historyEntry) {
