function stakeoutAlertRows(now = Date.now()) {
const cache = targetStakeoutAlertCache();
const snoozed = dataState.settings.alerts.snoozedUntil || {};
const rows = [];
for (const [id, alert] of Object.entries(cache)) {
if (Number(alert?.expiresAt) <= now) {
delete cache[id];
continue;
}
